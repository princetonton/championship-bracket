---
import Base from '../layouts/Base.astro';
import { GROUPS, GROUP_LETTERS } from '../data/groups';
import { RESULTS } from '../data/results';
import { getGroupFixtures, getAllFixtureIds } from '../data/fixtures';
import { FIXTURE_SCHEDULE } from '../data/schedule';

// Build full fixture list with schedule data
const allFixtures = [];
for (const letter of GROUP_LETTERS) {
  const fixtures = getGroupFixtures(letter);
  for (const f of fixtures) {
    const sched = FIXTURE_SCHEDULE[f.id] || {};
    allFixtures.push({
      id: f.id,
      group: letter,
      homeIdx: f.homeIdx,
      awayIdx: f.awayIdx,
      matchday: f.matchday,
      date: sched.date || '',
      timeET: sched.timeET || '',
      timeCEST: sched.timeCEST || '',
      venue: sched.venue || '',
    });
  }
}

// Ranking list (from user's profile)
const rankingList = [
  { name: 'Balldrian P', pts: 103, rang: 1 },
  { name: 'Manfred P', pts: 103, rang: 1 },
  { name: 'Martina Z', pts: 101, rang: 3 },
  { name: 'Raphael Bucher', pts: 100, rang: 4 },
  { name: 'Fan Zone', pts: 97, rang: 5 },
  { name: 'Vincent R', pts: 96, rang: 6 },
  { name: 'Manu C', pts: 95, rang: 7 },
  { name: 'Senada E', pts: 93, rang: 8 },
  { name: 'Corinna A', pts: 91, rang: 9 },
  { name: 'Michael B', pts: 86, rang: 10 },
  { name: 'Leonor R', pts: 86, rang: 10 },
  { name: 'Guirec BZH', pts: 86, rang: 10 },
  { name: 'Lisa K', pts: 85, rang: 13 },
  { name: 'Dani A', pts: 85, rang: 13 },
  { name: 'Reto B', pts: 84, rang: 15 },
  { name: 'Silvano Maradona', pts: 83, rang: 16 },
  { name: 'Marine P', pts: 82, rang: 17 },
  { name: '12 Points go to Switzerland', pts: 82, rang: 17 },
  { name: 'Julia B', pts: 81, rang: 19 },
  { name: 'Stefan M', pts: 80, rang: 20 },
];

// Bookmaker winner odds (as of June 18, 2026)
const winnerOdds = {
  France: { american: 410, probability: 0.196, tier: 'favorite' },
  Spain: { american: 480, probability: 0.172, tier: 'favorite' },
  England: { american: 650, probability: 0.133, tier: 'favorite' },
  Portugal: { american: 900, probability: 0.100, tier: 'contender' },
  Argentina: { american: 900, probability: 0.100, tier: 'contender' },
  Brazil: { american: 1000, probability: 0.091, tier: 'contender' },
  Germany: { american: 1400, probability: 0.067, tier: 'contender' },
  Netherlands: { american: 1700, probability: 0.056, tier: 'contender' },
  Norway: { american: 3300, probability: 0.029, tier: 'outsider' },
  USA: { american: 3500, probability: 0.028, tier: 'outsider' },
  Belgium: { american: 3500, probability: 0.028, tier: 'outsider' },
  Colombia: { american: 3500, probability: 0.028, tier: 'outsider' },
  Japan: { american: 4500, probability: 0.022, tier: 'outsider' },
  Morocco: { american: 4500, probability: 0.022, tier: 'outsider' },
  Mexico: { american: 5500, probability: 0.018, tier: 'outsider' },
  Uruguay: { american: 8000, probability: 0.012, tier: 'longshot' },
  Switzerland: { american: 8000, probability: 0.012, tier: 'longshot' },
};

// Host nations
const hostNations = ['Mexico', 'USA', 'Canada'];

const allFixtureData = JSON.stringify(allFixtures);
const groupsData = JSON.stringify(GROUPS);
const resultsData = JSON.stringify(RESULTS);
const rankingData = JSON.stringify(rankingList);
const oddsData = JSON.stringify(winnerOdds);
const hostsData = JSON.stringify(hostNations);
const lettersData = JSON.stringify(GROUP_LETTERS);
---

<Base>
  <header>
    <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
      <div>
        <h1>🏆 WM-Tipp-Assistent</h1>
        <div class="subtitle">Dein persönlicher KI-Tippgeber — Dani A · Rang #13 · 85 Pkt</div>
      </div>
      <a href="/" class="back-link" style="color:var(--accent2);font-size:0.85rem">← Back to Tracker</a>
    </div>
  </header>

  <main class="container">
    <!-- Password lock -->
    <div id="password-lock" class="password-lock">
      <div class="password-lock-inner">
        <div style="font-size:2rem;margin-bottom:8px">🔒</div>
        <h2 style="margin-bottom:4px">Password Required</h2>
        <p style="color:var(--textDim);font-size:0.85rem;margin-bottom:16px">Enter the password to access your personal assistant.</p>
        <div style="display:flex;gap:8px;flex-direction:column;align-items:center">
          <input type="password" id="password-input" placeholder="Password" style="background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--text);padding:8px 14px;font-size:0.9rem;width:200px;text-align:center" />
          <button class="btn btn-primary" id="unlock-btn">Unlock</button>
          <span id="password-error" style="color:var(--red);font-size:0.8rem;display:none">Incorrect password</span>
        </div>
      </div>
    </div>

    <!-- Content (hidden until unlocked) -->
    <div id="assistant-content" style="display:none">
      <!-- Tab Navigation -->
      <div class="tab-nav" id="tab-nav">
        <button class="tab-btn active" data-tab="dashboard">📊 Dashboard</button>
        <button class="tab-btn" data-tab="tipps">🎯 Tipp-Assistent</button>
        <button class="tab-btn" data-tab="gruppen">📋 Gruppen</button>
        <button class="tab-btn" data-tab="weltmeister">🏆 Weltmeister</button>
        <button class="tab-btn" data-tab="ko">⚔️ K.O.-Phase</button>
      </div>

      <!-- Tab: Dashboard -->
      <div id="tab-dashboard" class="tab-content active">
        <section class="section">
          <h2 class="section-title">📊 Dashboard</h2>
          <div class="dashboard-cards">
            <div class="card dashboard-card">
              <div class="dash-label">Dein Rang</div>
              <div class="dash-value gold">#13</div>
              <div class="dash-sub">von 20 Spielern</div>
            </div>
            <div class="card dashboard-card">
              <div class="dash-label">Punkte</div>
              <div class="dash-value">85</div>
              <div class="dash-sub">18 Pkt Rückstand auf Platz 1</div>
            </div>
            <div class="card dashboard-card">
              <div class="dash-label">Weltmeister-Tipp</div>
              <div class="dash-value gold">🇫🇷 Frankreich</div>
              <div class="dash-sub">Fix — nicht änderbar</div>
            </div>
            <div class="card dashboard-card" id="prognosis-card">
              <div class="dash-label">Punkte-Prognose</div>
              <div class="dash-value" id="prognosis-value">85</div>
              <div class="dash-sub" id="prognosis-sub">0 richtige Tipps heute</div>
              <div class="slider-container" style="margin-top:12px">
                <input type="range" id="prognosis-slider" min="0" max="4" value="0" step="1" style="width:100%">
                <div class="slider-labels">
                  <span>0</span><span>1</span><span>2</span><span>3</span><span>4</span>
                </div>
              </div>
              <div id="prognosis-detail" style="margin-top:8px;font-size:0.85rem;color:var(--textDim)"></div>
            </div>
          </div>
        </section>

        <section class="section">
          <h2 class="section-title">⏰ Nächste Spiele</h2>
          <div id="next-matches" class="next-matches-list"></div>
        </section>
      </div>

      <!-- Tab: Tipp-Assistent -->
      <div id="tab-tipps" class="tab-content">
        <section class="section">
          <h2 class="section-title">🎯 Spiel-Tipp-Assistent</h2>
          <p class="section-subtitle">Für jedes anstehende Spiel: Analyse, Empfehlung und dein persönlicher Tipp.</p>
          <div class="filter-bar" style="margin-bottom:16px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <span style="font-size:0.85rem;color:var(--textDim)">Filter:</span>
            <button class="filter-btn active" data-filter="all">Alle</button>
            <button class="filter-btn" data-filter="today">Heute</button>
            <button class="filter-btn" data-filter="upcoming">Bevorstehend</button>
            <button class="btn btn-sm" id="export-tips-btn" style="margin-left:auto">📤 Alle exportieren</button>
          </div>
          <div id="tipps-list" class="tipps-list"></div>
        </section>
      </div>

      <!-- Tab: Gruppen -->
      <div id="tab-gruppen" class="tab-content">
        <section class="section">
          <h2 class="section-title">📋 Gruppen-Tabellen</h2>
          <p class="section-subtitle">Aktuelle Tabellen mit Punkten, Toren und Prognose.</p>
          <div class="legend" style="display:flex;gap:16px;margin-bottom:16px;font-size:0.8rem">
            <span><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:var(--green);margin-right:4px"></span> Platz 1–2 (Qualifikation)</span>
            <span><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#ffa726;margin-right:4px"></span> Noch im Rennen</span>
            <span><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:var(--red);margin-right:4px"></span> Raus</span>
          </div>
          <div id="gruppen-list" class="gruppen-list"></div>
        </section>
      </div>

      <!-- Tab: Weltmeister -->
      <div id="tab-weltmeister" class="tab-content">
        <section class="section">
          <h2 class="section-title">🏆 Weltmeister-Tracker — Frankreich</h2>
          <p class="section-subtitle">Verfolge Frankreichs Weg zur Titelverteidigung.</p>
          <div id="weltmeister-content"></div>
        </section>
      </div>

      <!-- Tab: K.O.-Phase -->
      <div id="tab-ko" class="tab-content">
        <section class="section">
          <h2 class="section-title">⚔️ K.O.-Phase-Prognose</h2>
          <p class="section-subtitle">Voraussichtliche Paarungen basierend auf aktuellen Tabellen und Empfehlungen.</p>
          <div id="ko-content"></div>
        </section>
      </div>
    </div>
  </main>
</Base>

<!-- Embedded data -->
<script id="assistant-data" type="application/json" set:html={JSON.stringify({
  fixtures: allFixtures,
  groups: GROUPS,
  results: RESULTS,
  rankings: rankingList,
  odds: winnerOdds,
  hosts: hostNations,
  letters: GROUP_LETTERS,
})}></script>

<style is:global>
  .back-link { text-decoration: none; }
  .back-link:hover { text-decoration: underline; }

