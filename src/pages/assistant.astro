  function srfPoints(actual, predicted, isKnockout) {
    const outcomePts = isKnockout ? 10 : 5;
    const goalPts = isKnockout ? 2 : 1;
    const gdPts = isKnockout ? 6 : 3;

    let pts = 0;
    const aw = actual.homeScore > actual.awayScore;
    const ad = actual.homeScore === actual.awayScore;
    const al = actual.homeScore < actual.awayScore;
    const pw = predicted.homeScore > predicted.awayScore;
    const pd = predicted.homeScore === predicted.awayScore;
    const pl = predicted.homeScore < predicted.awayScore;
    const outcomeCorrect = (aw && pw) || (ad && pd) || (al && pl);

    if (outcomeCorrect) {
      pts += outcomePts;
      const actualGD = actual.homeScore - actual.awayScore;
      const predGD = predicted.homeScore - predicted.awayScore;
      if (actualGD === predGD) pts += gdPts;
    }

    if (actual.homeScore === predicted.homeScore) pts += goalPts;
    if (actual.awayScore === predicted.awayScore) pts += goalPts;

    return pts;
  }

  function renderModelSummary(p1, p3, p4) {
    const v1Body = document.getElementById('v1-summary-body');
    const v3Body = document.getElementById('v3-summary-body');
