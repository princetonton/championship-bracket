      if (daniIdx >= 0) {
        allRanks[daniIdx].pts = newPts;
      }
      allRanks.sort((a, b) => b.pts - a.pts);
      let newRank = 1;
      for (let i = 0; i < allRanks.length; i++) {
        if (allRanks[i].name === 'Dani A') {
          newRank = i + 1;
          break;
        }
      }
      // Handle ties
      let rankDisplay = newRank;
      if (newRank > 1 && allRanks[newRank-2].pts === allRanks[newRank-1].pts) {
        rankDisplay = newRank - 1;
      }
      const ptsGap = allRanks[0].pts - newPts;
      detailEl.textContent = `→ Rang #${rankDisplay} (${ptsGap > 0 ? ptsGap + ' Pkt Rückstand auf Platz 1' : 'Platz 1! 🏆'})`;
    }

    slider.addEventListener('input', () => updatePrognosis(slider.value));
    updatePrognosis(0);
