        const homeTeam = groups[f.group].teams[f.homeIdx];
        const awayTeam = groups[f.group].teams[f.awayIdx];
        const rec = calculateRecommendation(homeTeam, awayTeam, f.group, false, f.venue);

        // Load saved tip from assistant localStorage
