    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent2);
    cursor: pointer;
  }

  .next-matches-list { display: flex; flex-direction: column; gap: 8px; }
  .next-match-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--surface);
    border-radius: var(--radius);
    border-left: 3px solid var(--accent);
    flex-wrap: wrap;
    gap: 8px;
  }
  .next-match-item.soon { border-left-color: var(--gold); }
  .next-match-teams { font-weight: 600; }
  .next-match-info { font-size: 0.8rem; color: var(--textDim); }
  .next-match-countdown { font-size: 0.85rem; color: var(--accent2); font-weight: 600; }

  .tipps-list { display: flex; flex-direction: column; gap: 16px; }
  .tipp-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
