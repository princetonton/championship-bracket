<script>
(function() {
  // Load embedded data
  const dataEl = document.getElementById('assistant-data');
  if (!dataEl) return;
  const DATA = JSON.parse(dataEl.textContent);

  const { fixtures, groups, results, rankings, odds, hosts, letters } = DATA;
  const GROUP_NAMES = {
    A:'Group A',B:'Group B',C:'Group C',D:'Group D',E:'Group E',F:'Group F',
    G:'Group G',H:'Group H',I:'Group I',J:'Group J',K:'Group K',L:'Group L'
  };

  // Flag emoji mapping
  const FLAGS = {
    'Mexico':'🇲🇽','South Africa':'🇿🇦','Korea Republic':'🇰🇷','Czechia':'🇨🇿',
    'Canada':'🇨🇦','Bosnia and Herzegovina':'🇧🇦','Qatar':'🇶🇦','Switzerland':'🇨🇭',
    'Brazil':'🇧🇷','Morocco':'🇲🇦','Haiti':'🇭🇹','Scotland':'🏴󠁧󠁢󠁳󠁣󠁴󠁿',
    'USA':'🇺🇸','Paraguay':'🇵🇾','Australia':'🇦🇺','Türkiye':'🇹🇷',
    'Germany':'🇩🇪','Curaçao':'🇨🇼',"Côte d'Ivoire":'🇨🇮','Ecuador':'🇪🇨',
    'Netherlands':'🇳🇱','Japan':'🇯🇵','Sweden':'🇸🇪','Tunisia':'🇹🇳',
    'Belgium':'🇧🇪','Egypt':'🇪🇬','Iran':'🇮🇷','New Zealand':'🇳🇿',
    'Spain':'🇪🇸','Cabo Verde':'🇨🇻','Saudi Arabia':'🇸🇦','Uruguay':'🇺🇾',
    'France':'🇫🇷','Senegal':'🇸🇳','Iraq':'🇮🇶','Norway':'🇳🇴',
    'Argentina':'🇦🇷','Algeria':'🇩🇿','Austria':'🇦🇹','Jordan':'🇯🇴',
    'Portugal':'🇵🇹','DR Congo':'🇨🇩','Uzbekistan':'🇺🇿','Colombia':'🇨🇴',
    'England':'🏴󠁧󠁢󠁥󠁮󠁧󠁿','Croatia':'🇭🇷','Ghana':'🇬🇭','Panama':'🇵🇦',
  };

  function flag(name) { return FLAGS[name] || '🏳️'; }
  function teamName(letter, idx) { return groups[letter].teams[idx].name; }

  // Check if a match is finished (has result)
  function isFinished(fid) {
    const r = results[fid];
    return r && typeof r.homeScore === 'number' && typeof r.awayScore === 'number';
  }

  function getResult(fid) {
    return results[fid] || null;
  }

  // Get form points from results
  function getFormPoints(team, groupLetter) {
    let pts = 0;
    const grpFixtures = fixtures.filter(f => f.group === groupLetter);
    for (const f of grpFixtures) {
      const r = getResult(f.id);
      if (!r) continue;
      const isHome = team === teamName(f.group, f.homeIdx);
      const isAway = team === teamName(f.group, f.awayIdx);
      if (!isHome && !isAway) continue;
      const homeScore = r.homeScore;
      const awayScore = r.awayScore;
      if (isHome && homeScore > awayScore) pts += 3;
      else if (isAway && awayScore > homeScore) pts += 3;
      else if (homeScore === awayScore) pts += 1;
    }
    return pts;
  }

  function getGoalsFor(team, groupLetter) {
    let gf = 0;
    const grpFixtures = fixtures.filter(f => f.group === groupLetter);
    for (const f of grpFixtures) {
      const r = getResult(f.id);
      if (!r) continue;
      const isHome = team === teamName(f.group, f.homeIdx);
      const isAway = team === teamName(f.group, f.awayIdx);
      if (!isHome && !isAway) continue;
      if (isHome) gf += r.homeScore;
      else gf += r.awayScore;
    }
    return gf;
  }

  function getGoalsAgainst(team, groupLetter) {
    let ga = 0;
    const grpFixtures = fixtures.filter(f => f.group === groupLetter);
    for (const f of grpFixtures) {
      const r = getResult(f.id);
      if (!r) continue;
      const isHome = team === teamName(f.group, f.homeIdx);
      const isAway = team === teamName(f.group, f.awayIdx);
      if (!isHome && !isAway) continue;
      if (isHome) ga += r.awayScore;
      else ga += r.homeScore;
    }
    return ga;
  }

  // ============ VENUE TO COUNTRY ============
  function getVenueCountry(venue) {
    if (!venue) return null;
    const v = venue.toLowerCase();
    if (v.includes('mexico city') || v.includes('guadalajara') || v.includes('monterrey')) return 'Mexico';
    if (v.includes('toronto') || v.includes('vancouver') || v.includes('edmonton')) return 'Canada';
    if (v.includes('atlanta') || v.includes('los angeles') || v.includes('san francisco') ||
        v.includes('seattle') || v.includes('new york') || v.includes('new jersey') ||
        v.includes('boston') || v.includes('philadelphia') || v.includes('miami') ||
        v.includes('dallas') || v.includes('houston') || v.includes('kansas city')) return 'USA';
    return null;
  }

  // ============ RECOMMENDATION ENGINE ============
  function calculateRecommendation(homeTeam, awayTeam, groupLetter, isNeutral, venue) {
    const rankDiff = homeTeam.rank - awayTeam.rank; // negative = home is better
    const homeForm = getFormPoints(homeTeam.name, groupLetter);
    const awayForm = getFormPoints(awayTeam.name, groupLetter);
    const isHomeHost = hosts.includes(homeTeam.name);

    // Odds lookup
    function getOddsTier(name) {
      const o = odds[name];
      if (!o) return 0;
      if (o.tier === 'favorite') return 3;
      if (o.tier === 'contender') return 2;
      if (o.tier === 'outsider') return 1;
      return 0;
    }
    const oddsHome = getOddsTier(homeTeam.name);
    const oddsAway = getOddsTier(awayTeam.name);
    const oddsDiff = oddsHome - oddsAway;

    // Home advantage: ONLY if host nation plays in its own country
    const venueCountry = getVenueCountry(venue);
    const isHomeVenue = venueCountry === homeTeam.name;
    const homeAdv = (!isNeutral && isHomeHost && isHomeVenue) ? 5 : 0;

    // Form factor: each form point = 1 rank position
    const formDiff = (homeForm - awayForm);

    // Effective rank diff with all factors
    const effectiveRankDiff = rankDiff - homeAdv - oddsDiff - formDiff;

    let winner, score, confidence, reasoning;
    const reasons = [];

    // Build reasoning
    const diffStr = Math.abs(rankDiff);
    if (rankDiff < 0) {
      reasons.push(`${homeTeam.name} ist ${diffStr} Ränge besser (FIFA #${homeTeam.rank} vs #${awayTeam.rank})`);
    } else if (rankDiff > 0) {
      reasons.push(`${awayTeam.name} ist ${diffStr} Ränge besser (FIFA #${awayTeam.rank} vs #${homeTeam.rank})`);
    } else {
      reasons.push('Gleiches FIFA-Ranking');
    }

    if (!isNeutral && isHomeHost && isHomeVenue) reasons.push(`🏠 Heimvorteil: ${homeTeam.name} (Gastgeber, spielt im eigenen Land)`);
    else if (isHomeHost && !isHomeVenue) reasons.push(`ℹ️ ${homeTeam.name} ist Gastgeber, spielt aber nicht im eigenen Land → kein Heimvorteil`);
    if (oddsDiff > 0) reasons.push(`📈 Buchmacher-Quoten favorisieren ${homeTeam.name}`);
    else if (oddsDiff < 0) reasons.push(`📈 Buchmacher-Quoten favorisieren ${awayTeam.name}`);

    const formStr = `${homeTeam.name}: ${homeForm}P, ${awayTeam.name}: ${awayForm}P`;
    reasons.push(`Form: ${formStr}`);

    const gfHome = getGoalsFor(homeTeam.name, groupLetter);
    const gaHome = getGoalsAgainst(homeTeam.name, groupLetter);
    const gfAway = getGoalsFor(awayTeam.name, groupLetter);
    const gaAway = getGoalsAgainst(awayTeam.name, groupLetter);
    if (isFinished(`${groupLetter}_01`) || isFinished(`${groupLetter}_02`)) {
      reasons.push(`Tore: ${homeTeam.name} ${gfHome}:${gaHome}, ${awayTeam.name} ${gfAway}:${gaAway}`);
    }

    if (effectiveRankDiff <= -20) {
      winner = homeTeam.name;
      score = '3-0';
      confidence = '⭐⭐⭐';
      reasons.push('Klare Rang-Differenz → hohe Wahrscheinlichkeit für deutlichen Sieg');
    } else if (effectiveRankDiff <= -10) {
      winner = homeTeam.name;
      score = '2-0';
      confidence = '⭐⭐';
      reasons.push('Deutlicher Favorit → 2:0 ist das typischste Ergebnis');
    } else if (effectiveRankDiff <= -3) {
      winner = homeTeam.name;
      score = '2-1';
      confidence = '⭐⭐';
      reasons.push('Leichter Favorit → knapper Sieg erwartet');
    } else if (effectiveRankDiff <= 2) {
      if (!isNeutral && isHomeHost && homeForm >= awayForm) {
        winner = homeTeam.name;
        score = '2-1';
        confidence = '⭐⭐';
        reasons.push('Ausgeglichen, aber Heimvorteil + Form geben den Ausschlag');
      } else if (Math.abs(homeForm - awayForm) <= 1 && (homeForm > 0 || awayForm > 0)) {
        winner = 'draw';
        score = '1-1';
        confidence = '⭐';
        reasons.push('Sehr ausgeglichen → Unentschieden wahrscheinlich');
      } else if (homeForm > awayForm) {
        winner = homeTeam.name;
        score = '2-1';
        confidence = '⭐';
        reasons.push('Ausgeglichenes Ranking, aber bessere Form für ' + homeTeam.name);
      } else {
        winner = awayTeam.name;
        score = '1-2';
        confidence = '⭐';
        reasons.push('Ausgeglichenes Ranking, aber bessere Form für ' + awayTeam.name);
      }
    } else if (effectiveRankDiff <= 10) {
      winner = awayTeam.name;
      score = '1-2';
      confidence = '⭐⭐';
      reasons.push(`${awayTeam.name} ist leichter Favorit`);
    } else if (effectiveRankDiff <= 20) {
      winner = awayTeam.name;
      score = '0-2';
      confidence = '⭐⭐';
      reasons.push(`${awayTeam.name} ist deutlicher Favorit`);
    } else {
      winner = awayTeam.name;
      score = '0-3';
      confidence = '⭐⭐⭐';
      reasons.push(`${awayTeam.name} ist klarer Favorit`);
    }

    reasoning = reasons.join('. ');
    return { winner, score, confidence, reasoning };
  }

  // ============ GROUP STANDINGS ============
  function computeGroupStandings(letter) {
    const grp = groups[letter];
    const standings = grp.teams.map(t => {
      const name = t.name;
      const gf = getGoalsFor(name, letter);
      const ga = getGoalsAgainst(name, letter);
      const played = fixtures.filter(f => f.group === letter && isFinished(f.id)).length / 2;
      const form = getFormPoints(name, letter);
      return {
        name, rank: t.rank,
        played: fixtures.filter(f => f.group === letter).filter(f => isFinished(f.id)).filter(f => teamName(letter, f.homeIdx) === name || teamName(letter, f.awayIdx) === name).length,
        pts: form,
        gf, ga, gd: gf - ga,
      };
    });

    // Sort: pts > gd > gf
    standings.sort((a, b) => {
      if (b.pts !== a.pts) return b.pts - a.pts;
      if (b.gd !== a.gd) return b.gd - a.gd;
      if (b.gf !== a.gf) return b.gf - a.gf;
      return a.rank - b.rank;
    });
    return standings;
  }

