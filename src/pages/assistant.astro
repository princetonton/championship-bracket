          <div class="tipp-recommendation">💡 Empfehlung: ${flag(winnerLabel)} ${scoreDisplay} <span class="conf">${rec.confidence}</span></div>
          <div class="tipp-input-row">
            <span style="font-size:0.85rem">✏️ Mein Tipp:</span>
            <input type="text" class="tipp-input" data-fid="${f.id}" placeholder="z.B. 2-1" value="${savedScore}" pattern="[0-9]-[0-9]" />
            <button class="btn btn-sm btn-save-tip" data-fid="${f.id}">💾 Speichern</button>
            <span class="tipp-saved" id="saved-${f.id}" style="display:${saved ? 'inline' : 'none'}">✅</span>
          </div>
        </div>`;
      }).join('');

      // Save tip handlers
      document.querySelectorAll('.btn-save-tip').forEach(btn => {
        btn.addEventListener('click', function() {
          const fid = this.dataset.fid;
          const input = document.querySelector(`.tipp-input[data-fid="${fid}"]`);
          const val = input.value.trim();
          if (val && /^\d+-\d+$/.test(val)) {
            localStorage.setItem('assistant_tip_' + fid, val);
            document.getElementById('saved-' + fid).style.display = 'inline';
          } else if (!val) {
            localStorage.removeItem('assistant_tip_' + fid);
            document.getElementById('saved-' + fid).style.display = 'none';
          }
        });
      });

      // Enter key
      document.querySelectorAll('.tipp-input').forEach(inp => {
        inp.addEventListener('keydown', e => {
          if (e.key === 'Enter') {
            const fid = inp.dataset.fid;
            const btn = document.querySelector(`.btn-save-tip[data-fid="${fid}"]`);
            if (btn) btn.click();
          }
        });
