    align-items: center;
    justify-content: center;
    min-height: 50vh;
  }
  .password-lock-inner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    text-align: center;
    max-width: 340px;
    width: 100%;
  }

  .tab-nav {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
