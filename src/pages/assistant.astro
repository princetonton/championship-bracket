  // ============ HAUPT-APP ENGINES VERGLEICH ============
  function setupModelleApp() {
    document.getElementById('compare-app-btn').addEventListener('click', async function() {
      const status = document.getElementById('compare-app-status');
      const resultsEl = document.getElementById('compare-app-results');
      status.textContent = '⏳ Berechne prediction.js und prediction4.js...';
      resultsEl.style.display = 'none';

      try {
        const [modOld, modNew] = await Promise.all([
          import('/src/lib/prediction.js'),
          import('/src/lib/prediction4.js'),
        ]);

        const predOld = modOld.generateDeterministicPredictions('fifa');
        const predNew = modNew.generateDeterministicPredictions('fifa');

        status.textContent = '✅ Vergleich bereit!';
        renderAppSummary(predOld, predNew);
        renderAppGroupComparison(predOld, predNew);
        renderAppKoComparison(predOld, predNew);
        resultsEl.style.display = 'block';
      } catch (e) {
        status.textContent = '❌ Fehler: ' + e.message;
        console.error('[Modelle App] Fehler:', e);
      }
    });
  }

  function renderAppSummary(pOld, pNew) {
    const oldBody = document.getElementById('pred1-summary-body');
    const newBody = document.getElementById('pred4-summary-body');

    let oldTotal = 0, newTotal = 0, playedCount = 0;
    let oldExact = 0, newExact = 0, oldOutcome = 0, newOutcome = 0;
    for (const f of fixtures) {
      const actual = results[f.id];
      if (!actual) continue;
      playedCount++;
      const r1 = pOld.matchResults[f.id];
      const r2 = pNew.matchResults[f.id];
      if (r1) { const pts = srfPoints(actual, r1); oldTotal += pts; if (pts === 10) oldExact++; else if (pts >= 5) oldOutcome++; }
      if (r2) { const pts = srfPoints(actual, r2); newTotal += pts; if (pts === 10) newExact++; else if (pts >= 5) newOutcome++; }
    }

    const maxPts = Math.max(oldTotal, newTotal);
    const diff = newTotal - oldTotal;
    const diffStr = diff > 0 ? `+${diff}` : diff < 0 ? diff : '±0';

    oldBody.innerHTML = `
      <div style="font-size:1.1rem;font-weight:700;margin:8px 0">🏆 ${flag(pOld.champion)} ${pOld.champion}</div>
      <div style="font-size:0.85rem;color:var(--textDim)">🇨🇭 SUI: ${pOld.switzerlandRound} (${pOld.switzerlandGoals} Tore)</div>
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        <div style="font-size:1.3rem;font-weight:800;color:${oldTotal === maxPts ? 'var(--green)' : 'var(--textDim)'}">${oldTotal} Pkt</div>
        <div style="font-size:0.75rem;color:var(--textDim)">${playedCount} Spiele · ⌀ ${(oldTotal/playedCount).toFixed(1)}/Spiel</div>
        <div style="font-size:0.75rem;color:var(--textDim)">🎯 ${oldExact}× exakt · ✅ ${oldOutcome}× Tendenz</div>
      </div>
    `;
    newBody.innerHTML = `
      <div style="font-size:1.1rem;font-weight:700;margin:8px 0">🏆 ${flag(pNew.champion)} ${pNew.champion}</div>
      <div style="font-size:0.85rem;color:var(--textDim)">🇨🇭 SUI: ${pNew.switzerlandRound} (${pNew.switzerlandGoals} Tore)</div>
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
        <div style="font-size:1.3rem;font-weight:800;color:${newTotal === maxPts ? 'var(--green)' : 'var(--textDim)'}">${newTotal} Pkt</div>
        <div style="font-size:0.75rem;color:var(--textDim)">${playedCount} Spiele · ⌀ ${(newTotal/playedCount).toFixed(1)}/Spiel</div>
        <div style="font-size:0.75rem;color:var(--textDim)">🎯 ${newExact}× exakt · ✅ ${newOutcome}× Tendenz</div>
      </div>
    `;

    const existing = document.getElementById('srf-leader-app');
    if (existing) existing.remove();
    const badge = document.createElement('div');
    badge.id = 'srf-leader-app';
    badge.style.cssText = 'text-align:center;margin-bottom:12px;font-size:0.9rem;padding:8px;border-radius:6px;background:rgba(42,58,92,0.2)';
    const winner = newTotal > oldTotal ? 'prediction4.js (v4) führt' :
      oldTotal > newTotal ? 'prediction.js (v1) führt' : 'Gleichstand';
    badge.innerHTML = `<strong>SRF Tippspiel:</strong> prediction.js ${oldTotal} · prediction4.js ${newTotal} Pkt — <strong>${winner} (Δ${diffStr})</strong>` +
      ` · Weltmeister: ${flag(pOld.champion)} ${pOld.champion} → ${flag(pNew.champion)} ${pNew.champion}`;
    document.getElementById('pred1-summary').parentElement.parentElement.insertBefore(badge, document.getElementById('pred1-summary').parentElement);
  }

  function renderAppGroupComparison(pOld, pNew) {
