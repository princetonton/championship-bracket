  // ============ K.O.-PHASE ============
  function renderKO() {
    const el = document.getElementById('ko-content');

    // Simplified KO predictions based on current standings + recommendations
    function getGroupQualifiers(letter) {
      const s = computeGroupStandings(letter);
      return { winner: s[0]?.name || '?', runnerUp: s[1]?.name || '?', third: s[2]?.name || '?' };
    }

    const quals = {};
    letters.forEach(l => { quals[l] = getGroupQualifiers(l); });

    // R32 pairings (simplified)
    const r32 = [
      { id: 'R32-1', home: `2. ${quals.A.runnerUp}`, away: `2. ${quals.B.runnerUp}` },
      { id: 'R32-2', home: `1. ${quals.E.winner}`, away: `3. (Gruppe A/B/C/D/F)` },
      { id: 'R32-3', home: `1. ${quals.C.winner}`, away: `2. ${quals.F.runnerUp}` },
      { id: 'R32-4', home: `1. ${quals.F.winner}`, away: `2. ${quals.C.runnerUp}` },
      { id: 'R32-5', home: `1. ${quals.I.winner}`, away: `3. (Gruppe C/D/F/G/H)` },
      { id: 'R32-6', home: `2. ${quals.E.runnerUp}`, away: `2. ${quals.I.runnerUp}` },
