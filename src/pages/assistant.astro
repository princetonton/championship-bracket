        const s2 = `${r2.homeScore}-${r2.awayScore}`;

        let pts1 = 0, pts2 = 0;
        if (actual) {
          pts1 = srfPoints(actual, r1);
          pts2 = srfPoints(actual, r2);
          totalOld += pts1; totalNew += pts2; totalPlayed++;
        }

        const d1 = actual ? ' (' + pts1 + ')' : '';
        const d2 = actual ? ' (' + pts2 + ')' : '';
        const better = actual ? (pts2 > pts1 ? 'v4✅' : pts1 > pts2 ? 'v1' : '=') : '—';
