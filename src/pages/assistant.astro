</style>

<script>
(function() {
  // Load embedded data
  const dataEl = document.getElementById('assistant-data');
  if (!dataEl) return;
  const DATA = JSON.parse(dataEl.textContent);

  const { fixtures, groups, results, rankings, odds, hosts, letters } = DATA;
  const GROUP_NAMES = {
    A:'Group A',B:'Group B',C:'Group C',D:'Group D',E:'Group E',F:'Group F',
    G:'Group G',H:'Group H',I:'Group I',J:'Group J',K:'Group K',L:'Group L'
  };

  // Flag emoji mapping
  const FLAGS = {
    'Mexico':'🇲🇽','South Africa':'🇿🇦','Korea Republic':'🇰🇷','Czechia':'🇨🇿',
    'Canada':'🇨🇦','Bosnia and Herzegovina':'🇧🇦','Qatar':'🇶🇦','Switzerland':'🇨🇭',
    'Brazil':'🇧🇷','Morocco':'🇲🇦','Haiti':'🇭🇹','Scotland':'🏴󠁧󠁢󠁳󠁣󠁴󠁿',
    'USA':'🇺🇸','Paraguay':'🇵🇾','Australia':'🇦🇺','Türkiye':'🇹🇷',
    'Germany':'🇩🇪','Curaçao':'🇨🇼',"Côte d'Ivoire":'🇨🇮','Ecuador':'🇪🇨',
    'Netherlands':'🇳🇱','Japan':'🇯🇵','Sweden':'🇸🇪','Tunisia':'🇹🇳',
    'Belgium':'🇧🇪','Egypt':'🇪🇬','Iran':'🇮🇷','New Zealand':'🇳🇿',
    'Spain':'🇪🇸','Cabo Verde':'🇨🇻','Saudi Arabia':'🇸🇦','Uruguay':'🇺🇾',
    'France':'🇫🇷','Senegal':'🇸🇳','Iraq':'🇮🇶','Norway':'🇳🇴',
    'Argentina':'🇦🇷','Algeria':'🇩🇿','Austria':'🇦🇹','Jordan':'🇯🇴',
    'Portugal':'🇵🇹','DR Congo':'🇨🇩','Uzbekistan':'🇺🇿','Colombia':'🇨🇴',
    'England':'🏴󠁧󠁢󠁥󠁮󠁧󠁿','Croatia':'🇭🇷','Ghana':'🇬🇭','Panama':'🇵🇦',
  };

  function flag(name) { return FLAGS[name] || '🏳️'; }
  function teamName(letter, idx) { return groups[letter].teams[idx].name; }

  // Check if a match is finished (has result)
  function isFinished(fid) {
    const r = results[fid];
    return r && typeof r.homeScore === 'number' && typeof r.awayScore === 'number';
  }

  function getResult(fid) {
    return results[fid] || null;
  }

  // Get form points from results
  function getFormPoints(team, groupLetter) {
    let pts = 0;
    const grpFixtures = fixtures.filter(f => f.group === groupLetter);
    for (const f of grpFixtures) {
      const r = getResult(f.id);
      if (!r) continue;
      const isHome = team === teamName(f.group, f.homeIdx);
      const isAway = team === teamName(f.group, f.awayIdx);
      if (!isHome && !isAway) continue;
      const homeScore = r.homeScore;
      const awayScore = r.awayScore;
      if (isHome && homeScore > awayScore) pts += 3;
      else if (isAway && awayScore > homeScore) pts += 3;
      else if (homeScore === awayScore) pts += 1;
    }
    return pts;
  }

  function getGoalsFor(team, groupLetter) {
    let gf = 0;
    const grpFixtures = fixtures.filter(f => f.group === groupLetter);
    for (const f of grpFixtures) {
      const r = getResult(f.id);
      if (!r) continue;
      const isHome = team === teamName(f.group, f.homeIdx);
      const isAway = team === teamName(f.group, f.awayIdx);
      if (!isHome && !isAway) continue;
      if (isHome) gf += r.homeScore;
      else gf += r.awayScore;
    }
    return gf;
  }

  function getGoalsAgainst(team, groupLetter) {
    let ga = 0;
    const grpFixtures = fixtures.filter(f => f.group === groupLetter);
    for (const f of grpFixtures) {
      const r = getResult(f.id);
      if (!r) continue;
      const isHome = team === teamName(f.group, f.homeIdx);
      const isAway = team === teamName(f.group, f.awayIdx);
      if (!isHome && !isAway) continue;
      if (isHome) ga += r.awayScore;
      else ga += r.homeScore;
    }
    return ga;
  }

  // ============ VENUE TO COUNTRY ============
  function getVenueCountry(venue) {
    if (!venue) return null;
    const v = venue.toLowerCase();
    if (v.includes('mexico city') || v.includes('guadalajara') || v.includes('monterrey')) return 'Mexico';
    if (v.includes('toronto') || v.includes('vancouver') || v.includes('edmonton')) return 'Canada';
    if (v.includes('atlanta') || v.includes('los angeles') || v.includes('san francisco') ||
        v.includes('seattle') || v.includes('new york') || v.includes('new jersey') ||
        v.includes('boston') || v.includes('philadelphia') || v.includes('miami') ||
        v.includes('dallas') || v.includes('houston') || v.includes('kansas city')) return 'USA';
    return null;
  }

  // ============ RECOMMENDATION ENGINE ============
  function calculateRecommendation(homeTeam, awayTeam, groupLetter, isNeutral, venue) {
    const rankDiff = homeTeam.rank - awayTeam.rank; // negative = home is better
    const homeForm = getFormPoints(homeTeam.name, groupLetter);
    const awayForm = getFormPoints(awayTeam.name, groupLetter);
    const isHomeHost = hosts.includes(homeTeam.name);

    // Odds lookup
    function getOddsTier(name) {
      const o = odds[name];
      if (!o) return 0;
      if (o.tier === 'favorite') return 3;
      if (o.tier === 'contender') return 2;
      if (o.tier === 'outsider') return 1;
      return 0;
    }
    const oddsHome = getOddsTier(homeTeam.name);
    const oddsAway = getOddsTier(awayTeam.name);
    const oddsDiff = oddsHome - oddsAway;

    // Home advantage: ONLY if host nation plays in its own country
    const venueCountry = getVenueCountry(venue);
    const isHomeVenue = venueCountry === homeTeam.name;
    const homeAdv = (!isNeutral && isHomeHost && isHomeVenue) ? 5 : 0;

    // Form factor: each form point = 1 rank position
    const formDiff = (homeForm - awayForm);

    // Effective rank diff with all factors
    const effectiveRankDiff = rankDiff - homeAdv - oddsDiff - formDiff;

    let winner, score, confidence, reasoning;
    const reasons = [];

    // Build reasoning
    const diffStr = Math.abs(rankDiff);
    if (rankDiff < 0) {
      reasons.push(`${homeTeam.name} ist ${diffStr} Ränge besser (FIFA #${homeTeam.rank} vs #${awayTeam.rank})`);
    } else if (rankDiff > 0) {
      reasons.push(`${awayTeam.name} ist ${diffStr} Ränge besser (FIFA #${awayTeam.rank} vs #${homeTeam.rank})`);
    } else {
      reasons.push('Gleiches FIFA-Ranking');
    }

    if (!isNeutral && isHomeHost && isHomeVenue) reasons.push(`🏠 Heimvorteil: ${homeTeam.name} (Gastgeber, spielt im eigenen Land)`);
    else if (isHomeHost && !isHomeVenue) reasons.push(`ℹ️ ${homeTeam.name} ist Gastgeber, spielt aber nicht im eigenen Land → kein Heimvorteil`);
    if (oddsDiff > 0) reasons.push(`📈 Buchmacher-Quoten favorisieren ${homeTeam.name}`);
    else if (oddsDiff < 0) reasons.push(`📈 Buchmacher-Quoten favorisieren ${awayTeam.name}`);

    const formStr = `${homeTeam.name}: ${homeForm}P, ${awayTeam.name}: ${awayForm}P`;
    reasons.push(`Form: ${formStr}`);

    const gfHome = getGoalsFor(homeTeam.name, groupLetter);
    const gaHome = getGoalsAgainst(homeTeam.name, groupLetter);
    const gfAway = getGoalsFor(awayTeam.name, groupLetter);
    const gaAway = getGoalsAgainst(awayTeam.name, groupLetter);
    if (isFinished(`${groupLetter}_01`) || isFinished(`${groupLetter}_02`)) {
      reasons.push(`Tore: ${homeTeam.name} ${gfHome}:${gaHome}, ${awayTeam.name} ${gfAway}:${gaAway}`);
    }

    // Strategic Predictor v2.2 model: pure rank-gap with home advantage
    const v22HomeAdv = isNeutral ? 0 : 3;
    const v22Gap = (homeTeam.rank - v22HomeAdv) - awayTeam.rank;
    const v22AbsGap = Math.abs(v22Gap);
    const v22HomeFavored = v22Gap < 0;
    const favored = v22HomeFavored ? homeTeam.name : awayTeam.name;
    const underdog = v22HomeFavored ? awayTeam.name : homeTeam.name;

    if (v22AbsGap >= 60) {
      winner = favored;
      score = v22HomeFavored ? '5-0' : '0-5';
      confidence = '⭐⭐⭐';
      reasons.push('Extreme Rang-Differenz → vernichtender Kantersieg erwartet');
    } else if (v22AbsGap >= 50) {
      winner = favored;
      score = v22HomeFavored ? '4-0' : '0-4';
      confidence = '⭐⭐⭐';
      reasons.push('Sehr grosse Rang-Differenz → hoher Sieg mit Sauberem Blatt');
    } else if (v22AbsGap >= 20) {
      winner = favored;
      score = v22HomeFavored ? '3-0' : '0-3';
      confidence = '⭐⭐⭐';
      reasons.push('Klare Rang-Differenz → dominanter Sieg erwartet');
    } else if (v22AbsGap >= 8) {
      winner = favored;
      score = v22HomeFavored ? '2-0' : '0-2';
      confidence = '⭐⭐';
      reasons.push('Deutlicher Favorit → komfortabler Sieg mit weisser Weste');
    } else if (v22AbsGap >= 3) {
      winner = favored;
      score = v22HomeFavored ? '2-1' : '1-2';
      confidence = '⭐⭐';
      reasons.push(`Favorit siegt knapp, ${underdog} trifft zum Ehrentor`);
    } else if (v22AbsGap >= 1) {
      winner = favored;
      score = v22HomeFavored ? '1-0' : '0-1';
      confidence = '⭐⭐';
      reasons.push('Enge Kiste → knapper Favoritensieg mit einem Tor Unterschied');
    } else {
      winner = 'draw';
      score = '1-1';
      confidence = '⭐';
      reasons.push('Ausgeglichenes Spiel → Unentschieden wahrscheinlich');
    }

    reasoning = reasons.join('. ');
    return { winner, score, confidence, reasoning };
  }

  // ============ GROUP STANDINGS ============
  function computeGroupStandings(letter) {
    const grp = groups[letter];
    const standings = grp.teams.map(t => {
      const name = t.name;
      const gf = getGoalsFor(name, letter);
      const ga = getGoalsAgainst(name, letter);
      const played = fixtures.filter(f => f.group === letter && isFinished(f.id)).length / 2;
      const form = getFormPoints(name, letter);
      return {
        name, rank: t.rank,
        played: fixtures.filter(f => f.group === letter).filter(f => isFinished(f.id)).filter(f => teamName(letter, f.homeIdx) === name || teamName(letter, f.awayIdx) === name).length,
        pts: form,
        gf, ga, gd: gf - ga,
      };
    });

    // Sort: pts > gd > gf
    standings.sort((a, b) => {
      if (b.pts !== a.pts) return b.pts - a.pts;
      if (b.gd !== a.gd) return b.gd - a.gd;
      if (b.gf !== a.gf) return b.gf - a.gf;
      return a.rank - b.rank;
    });
    return standings;
  }

  // ============ TODAY'S MATCHES ============
  function getTodaysFixtures() {
    return fixtures.filter(f => {
      const s = f.date;
      return s === 'Jun 18' || s === 'Jun 18';
    });
  }

  function getUpcomingFixtures() {
    const today = new Date();
    return fixtures.filter(f => !isFinished(f.id));
  }

  function getNextMatchdays(count) {
    const unfinished = fixtures.filter(f => !isFinished(f.id));
    const dateOrder = ['Jun 18','Jun 19','Jun 20','Jun 21','Jun 22','Jun 23','Jun 24','Jun 25','Jun 26','Jun 27'];
    unfinished.sort((a, b) => dateOrder.indexOf(a.date) - dateOrder.indexOf(b.date) || a.id.localeCompare(b.id));
    return unfinished.slice(0, count);
  }

  // ============ PASSWORD ============
  function setupPassword() {
    function unlock() {
      const pw = document.getElementById('password-input').value;
      if (pw === 'Dani-123!') {
        document.getElementById('password-lock').style.display = 'none';
        document.getElementById('assistant-content').style.display = 'block';
        sessionStorage.setItem('assistant_unlocked', '1');
      } else {
        document.getElementById('password-error').style.display = 'inline';
      }
    }
    document.getElementById('unlock-btn').addEventListener('click', unlock);
    document.getElementById('password-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') unlock();
    });
    if (sessionStorage.getItem('assistant_unlocked') === '1') {
      document.getElementById('password-lock').style.display = 'none';
      document.getElementById('assistant-content').style.display = 'block';
    }
  }

  // ============ TABS ============
  function setupTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    tabs.forEach(btn => {
      btn.addEventListener('click', () => {
        tabs.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      });
    });
  }

  // ============ DASHBOARD ============
  function renderDashboard() {
    const nextList = document.getElementById('next-matches');
    const next5 = getNextMatchdays(5);
    nextList.innerHTML = next5.map(f => {
      const home = teamName(f.group, f.homeIdx);
      const away = teamName(f.group, f.awayIdx);
      const isToday = f.date === 'Jun 18';
      return `<div class="next-match-item ${isToday ? 'soon' : ''}">
        <div>
          <div class="next-match-teams">${flag(home)} ${home} vs ${flag(away)} ${away}</div>
          <div class="next-match-info">${f.date} · ${f.timeCEST} CEST · ${f.venue}</div>
        </div>
        <div class="next-match-countdown">${isToday ? '🔴 HEUTE' : f.date}</div>
      </div>`;
    }).join('');

    // Prognosis slider
    const slider = document.getElementById('prognosis-slider');
    const valEl = document.getElementById('prognosis-value');
    const subEl = document.getElementById('prognosis-sub');
    const detailEl = document.getElementById('prognosis-detail');
    const todayCount = getTodaysFixtures().length;

    slider.max = todayCount;
    function updatePrognosis(val) {
      const newPts = 85 + parseInt(val) * 7;
      valEl.textContent = newPts;
      subEl.textContent = `${val}/${todayCount} richtige Tipps heute`;

      // Compute new rank
      const allRanks = rankings.map(r => ({ ...r }));
      const daniIdx = allRanks.findIndex(r => r.name === 'Dani A');
      if (daniIdx >= 0) {
        allRanks[daniIdx].pts = newPts;
      }
      allRanks.sort((a, b) => b.pts - a.pts);
      let newRank = 1;
      for (let i = 0; i < allRanks.length; i++) {
        if (allRanks[i].name === 'Dani A') {
          newRank = i + 1;
          break;
        }
      }
      // Handle ties
      let rankDisplay = newRank;
      if (newRank > 1 && allRanks[newRank-2].pts === allRanks[newRank-1].pts) {
        rankDisplay = newRank - 1;
      }
      const ptsGap = allRanks[0].pts - newPts;
      detailEl.textContent = `→ Rang #${rankDisplay} (${ptsGap > 0 ? ptsGap + ' Pkt Rückstand auf Platz 1' : 'Platz 1! 🏆'})`;
    }

    slider.addEventListener('input', () => updatePrognosis(slider.value));
    updatePrognosis(0);
  }

  // ============ TIPP ASSISTENT ============
  function renderTipps() {
    const list = document.getElementById('tipps-list');
    const upcoming = fixtures.filter(f => !isFinished(f.id));
    const dateOrder = ['Jun 18','Jun 19','Jun 20','Jun 21','Jun 22','Jun 23','Jun 24','Jun 25','Jun 26','Jun 27'];
    upcoming.sort((a, b) => dateOrder.indexOf(a.date) - dateOrder.indexOf(b.date) || a.id.localeCompare(b.id));

    function render(filter) {
      let filtered = upcoming;
      if (filter === 'today') filtered = upcoming.filter(f => f.date === 'Jun 18');
      else if (filter === 'upcoming') filtered = upcoming.filter(f => f.date !== 'Jun 18');

      list.innerHTML = filtered.map(f => {
        const home = teamName(f.group, f.homeIdx);
        const away = teamName(f.group, f.awayIdx);
        const isToday = f.date === 'Jun 18';

        const homeTeam = groups[f.group].teams[f.homeIdx];
        const awayTeam = groups[f.group].teams[f.awayIdx];
        const rec = calculateRecommendation(homeTeam, awayTeam, f.group, false, f.venue);

        // Load saved tip from assistant localStorage
        const saved = localStorage.getItem('assistant_tip_' + f.id);
        const savedScore = saved || '';

        const winnerLabel = rec.winner === 'draw' ? 'Unentschieden' : rec.winner;
        const scoreDisplay = rec.winner === 'draw' ? rec.score : rec.score;

        return `<div class="tipp-card ${isToday ? 'today' : ''}" data-fixture="${f.id}">
          <div class="tipp-header">
            <div class="tipp-teams">${flag(home)} ${home} vs ${flag(away)} ${away}</div>
            <div class="tipp-date">${f.date} · ${f.timeCEST} CEST · ${f.group}</div>
          </div>
          <div class="tipp-analysis">${rec.reasoning}</div>
          <div class="tipp-recommendation">💡 Empfehlung: ${flag(winnerLabel)} ${scoreDisplay} <span class="conf">${rec.confidence}</span></div>
          <div class="tipp-input-row">
            <span style="font-size:0.85rem">✏️ Mein Tipp:</span>
            <input type="text" class="tipp-input" data-fid="${f.id}" placeholder="z.B. 2-1" value="${savedScore}" pattern="[0-9]-[0-9]" />
            <button class="btn btn-sm btn-save-tip" data-fid="${f.id}">💾 Speichern</button>
            <span class="tipp-saved" id="saved-${f.id}" style="display:${saved ? 'inline' : 'none'}">✅</span>
          </div>
        </div>`;
      }).join('');

      // Save tip handlers
      document.querySelectorAll('.btn-save-tip').forEach(btn => {
        btn.addEventListener('click', function() {
          const fid = this.dataset.fid;
          const input = document.querySelector(`.tipp-input[data-fid="${fid}"]`);
          const val = input.value.trim();
          if (val && /^\d+-\d+$/.test(val)) {
            localStorage.setItem('assistant_tip_' + fid, val);
            document.getElementById('saved-' + fid).style.display = 'inline';
          } else if (!val) {
            localStorage.removeItem('assistant_tip_' + fid);
            document.getElementById('saved-' + fid).style.display = 'none';
          }
        });
      });

      // Enter key
      document.querySelectorAll('.tipp-input').forEach(inp => {
        inp.addEventListener('keydown', e => {
          if (e.key === 'Enter') {
            const fid = inp.dataset.fid;
            const btn = document.querySelector(`.btn-save-tip[data-fid="${fid}"]`);
            if (btn) btn.click();
          }
        });
      });
    }

    // Filter buttons
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        render(this.dataset.filter);
      });
    });

    render('all');

    // Export tips
    document.getElementById('export-tips-btn').addEventListener('click', function() {
      const tips = {};
      for (const f of fixtures) {
        const saved = localStorage.getItem('assistant_tip_' + f.id);
        if (saved) {
