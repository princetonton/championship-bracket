  function renderGroupComparison(p1, p3, p4) {
    const container = document.getElementById('group-compare');
    const matchResults1 = p1.matchResults;
    const matchResults3 = p3.matchResults;
    const matchResults4 = p4.matchResults;

    let totalV1 = 0, totalV3 = 0, totalV4 = 0, totalPlayed = 0;

    let html = '';
    for (const letter of letters) {
      const grp = groups[letter];
      const grpFixtures = fixtures.filter(f => f.group === letter);

      html += `<div class="model-group-title">${GROUP_NAMES[letter]} — ${grp.name}</div>`;
      html += `<table class="model-table">
        <thead><tr>
          <th>Spiel</th>
          <th style="text-align:center">Resultat</th>
          <th style="text-align:center">v1</th>
          <th style="text-align:center">v3</th>
          <th style="text-align:center">v4</th>
          <th style="text-align:center">Gewinner</th>
        </tr></thead><tbody>`;

      for (const f of grpFixtures) {
        const home = teamName(letter, f.homeIdx);
        const away = teamName(letter, f.awayIdx);
        const actual = results[f.id];
        const r1 = matchResults1[f.id];
        const r3 = matchResults3[f.id];
        const r4 = matchResults4[f.id];
        if (!r1 || !r3 || !r4) continue;

        const actualStr = actual ? `${actual.homeScore}-${actual.awayScore}` : '—';
        const s1 = `${r1.homeScore}-${r1.awayScore}`;
        const s3 = `${r3.homeScore}-${r3.awayScore}`;
        const s4 = `${r4.homeScore}-${r4.awayScore}`;

        let pts1 = 0, pts3 = 0, pts4 = 0;
        if (actual) {
          pts1 = srfPoints(actual, r1);
          pts3 = srfPoints(actual, r3);
          pts4 = srfPoints(actual, r4);
          totalV1 += pts1; totalV3 += pts3; totalV4 += pts4; totalPlayed++;
        }

        const d1 = actual ? ' (' + pts1 + ')' : '';
        const d3 = actual ? ' (' + pts3 + ')' : '';
        const d4 = actual ? ' (' + pts4 + ')' : '';

        const maxPts = Math.max(pts1, pts3, pts4);
        let winner = '—';
        let winCls = '';
        if (actual) {
          if (maxPts === 0) { winner = '✗'; winCls = 'disagree'; }
          else if (maxPts === pts4 && pts4 > pts1 && pts4 > pts3) { winner = 'v4'; winCls = 'v4-sc'; }
          else if (maxPts === pts3 && pts3 > pts1 && pts3 > pts4) { winner = 'v3'; winCls = 'v3-sc'; }
          else if (maxPts === pts1 && pts1 > pts3 && pts1 > pts4) { winner = 'v1'; winCls = 'v1-sc'; }
          else if (maxPts > 0) { winner = '='; winCls = 'agree'; }
        }

        html += `<tr>
          <td class="m-team">${flag(home)} ${home} vs ${flag(away)} ${away}</td>
          <td style="text-align:center;font-weight:600;color:${actual ? 'var(--text)' : 'var(--textDim)'}">${actualStr}</td>
          <td class="v1-sc" style="text-align:center;font-size:0.8rem">${s1}<span style="color:${pts1 >= 8 ? 'var(--green)' : pts1 >= 5 ? 'var(--gold)' : pts1 > 0 ? 'var(--textDim)' : ''}">${d1}</span></td>
          <td class="v3-sc" style="text-align:center;font-size:0.8rem">${s3}<span style="color:${pts3 >= 8 ? 'var(--green)' : pts3 >= 5 ? 'var(--gold)' : pts3 > 0 ? 'var(--textDim)' : ''}">${d3}</span></td>
          <td class="v4-sc" style="text-align:center;font-size:0.8rem">${s4}<span style="color:${pts4 >= 8 ? 'var(--green)' : pts4 >= 5 ? 'var(--gold)' : pts4 > 0 ? 'var(--textDim)' : ''}">${d4}</span></td>
          <td class="${winCls}" style="text-align:center">${winner}</td>
        </tr>`;
      }

      html += `</tbody></table>`;
    }

    const maxTotal = Math.max(totalV1, totalV3, totalV4);
    const leader = maxTotal === totalV4 ? 'v4 +' + (totalV4 - Math.max(totalV1, totalV3)) :
      maxTotal === totalV3 ? 'v3 +' + (totalV3 - Math.max(totalV1, totalV4)) :
      'v1 +' + (totalV1 - Math.max(totalV3, totalV4));

    html = `<div style="margin-bottom:12px;padding:10px 14px;background:rgba(42,58,92,0.2);border-radius:6px;font-size:0.85rem">
      <strong>🏆 Total SRF Punkte (${totalPlayed} gespielte Spiele):</strong>
      v1 <span style="color:var(--accent2);font-weight:700">${totalV1}</span> ·
      v3 <span style="color:var(--green);font-weight:700">${totalV3}</span> ·
      v4 <span style="color:#a855f7;font-weight:700">${totalV4}</span> ·
      <strong>${leader}</strong>
    </div>` + html;

    container.innerHTML = html;
  }

