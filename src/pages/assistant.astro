    for (const f of fixtures) {
      const actual = results[f.id];
      if (!actual) continue;
      playedCount++;
      const r1 = p1.matchResults[f.id];
      const r3 = p3.matchResults[f.id];
      const r4 = p4.matchResults[f.id];
      if (r1) { const pts = srfPoints(actual, r1); v1Total += pts; if (pts === 10) v1Exact++; else if (pts >= 5) v1Outcome++; }
      if (r3) { const pts = srfPoints(actual, r3); v3Total += pts; if (pts === 10) v3Exact++; else if (pts >= 5) v3Outcome++; }
      if (r4) { const pts = srfPoints(actual, r4); v4Total += pts; if (pts === 10) v4Exact++; else if (pts >= 5) v4Outcome++; }
    }

    const maxPts = Math.max(v1Total, v3Total, v4Total);

    const champSame = (p1.champion === p3.champion && p3.champion === p4.champion)
