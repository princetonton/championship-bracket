          <td class="v1-sc" style="text-align:center">${s1} → ${flag(w1)}</td>
          <td class="v4-sc" style="text-align:center">${s2} → ${flag(w2)}</td>
          <td class="${allSame ? 'agree' : 'disagree'}" style="text-align:center">${matchIcon}</td>
        </tr>`;
      }

      html += `</tbody></table>
      </div>`;
    }

    container.innerHTML = html;
  }
})();
</script>
