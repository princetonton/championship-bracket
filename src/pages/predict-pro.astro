---
import Base from '../layouts/Base.astro';
import { GROUPS, GROUP_LETTERS } from '../data/groups';
import { getGroupFixtures } from '../data/fixtures';
import { FIXTURE_SCHEDULE } from '../data/schedule';
import { RESULTS } from '../data/results';
import { R16_MATCHUPS, QF_MATCHUPS, SF_MATCHUPS, FINAL_MATCHUPS } from '../data/bracket';
import { getModelComparison, predictFullTournament, predictRemainingGroup } from '../lib/prediction5';
import { generatePredictions as v3 } from '../lib/prediction';
import { generatePredictions as v4 } from '../lib/prediction4';
import { getTeamRankLookup, deterministicPredictMatch } from '../lib/prediction';
import { predictMatchScore4 } from '../lib/prediction4';
import { generateRoundOf32 } from '../lib/bracketLogic';
import { getBestThirdPlaced } from '../lib/qualification';
import { computeGroupStandings } from '../lib/standings';
import { knockoutPredictions } from '../data/baseline';

const cmp = getModelComparison(GROUPS, RESULTS);
const full = predictFullTournament(RESULTS, GROUPS);
const rem = predictRemainingGroup(RESULTS, GROUPS);

const v3pred = v3(42);
const v4pred = v4(42);

// Enrich RESULTS with home/away indices for standings computation
const enriched = {};
for (const letter of GROUP_LETTERS) {
  const fixtures = getGroupFixtures(letter);
  for (const f of fixtures) {
    const r = RESULTS[f.id];
    if (r) enriched[f.id] = { ...r, home: f.homeIdx, away: f.awayIdx };
  }
}

// --- KO scoring functions (no host advantage in knockout) ---
function v1koScore(homeRank, awayRank) {
  const gap = homeRank - awayRank, absGap = Math.abs(gap), hf = gap < 0;
  if (absGap >= 20) return hf ? { h: 3, a: 0 } : { h: 0, a: 3 };
  if (absGap >= 8) return hf ? { h: 2, a: 0 } : { h: 0, a: 2 };
  if (absGap >= 3) return hf ? { h: 2, a: 1 } : { h: 1, a: 2 };
  if (absGap >= 1) return hf ? { h: 1, a: 0 } : { h: 0, a: 1 };
  return { h: 1, a: 1 };
}
function v2koScore(homeRank, awayRank) {
  const gap = homeRank - awayRank, absGap = Math.abs(gap), hf = gap < 0;
  if (absGap >= 60) return hf ? { h: 5, a: 0 } : { h: 0, a: 5 };
  if (absGap >= 50) return hf ? { h: 4, a: 0 } : { h: 0, a: 4 };
  if (absGap >= 20) return hf ? { h: 3, a: 0 } : { h: 0, a: 3 };
  if (absGap >= 8) return hf ? { h: 2, a: 0 } : { h: 0, a: 2 };
  if (absGap >= 3) return hf ? { h: 2, a: 1 } : { h: 1, a: 2 };
  if (absGap >= 1) return hf ? { h: 1, a: 0 } : { h: 0, a: 1 };
  return { h: 1, a: 1 };
}

function getRank(teamName) {
  for (const l of GROUP_LETTERS) {
    const t = GROUPS[l].teams.find(tm => tm.name === teamName);
    if (t) return t.rank;
  }
  return 50;
}

function findInResults(results, id) {
  for (const k of Object.keys(results)) {
    if (k.startsWith(id)) return results[k];
  }
  return null;
}

// --- Bracket propagation for a model ---
// Takes a function `scoreFn(homeName, awayName) -> {h, a}` returns full knockout tree
function propagateBracket(scoreFn) {
  const standings = {};
  for (const l of GROUP_LETTERS) standings[l] = computeGroupStandings(l, enriched);
  const { qualified } = getBestThirdPlaced(enriched);
  const allQualified = new Set(qualified.map(t => t.name));

  // Check if team advanced from group
  function advanced(teamName) {
    for (const l of GROUP_LETTERS) {
      const st = standings[l];
      const pos = st.findIndex(t => t.name === teamName);
      if (pos >= 0) return pos <= 1 || (pos === 2 && allQualified.has(teamName));
    }
    return false;
  }

  const r32pairings = generateRoundOf32(enriched);

  function simRound(matchDefs, prevResults) {
    const results = {};
    const matches = matchDefs.map(m => {
      const hp = prevResults[m.prev[0]];
      const ap = prevResults[m.prev[1]];
      let hn = 'TBD', an = 'TBD';
      if (hp) hn = m.useLosers ? (hp.homeScore > hp.awayScore ? hp.awayName : hp.homeName) : (hp.homeScore > hp.awayScore ? hp.homeName : hp.awayName);
      if (ap) an = m.useLosers ? (ap.homeScore > ap.awayScore ? ap.awayName : ap.homeName) : (ap.homeScore > ap.awayScore ? ap.homeName : ap.awayName);
      // Score the match if both teams known
      if (hn !== 'TBD' && an !== 'TBD') {
        const s = scoreFn(hn, an);
        results[m.id] = { id: m.id, label: m.label, homeName: hn, awayName: an, homeScore: s.h, awayScore: s.a };
      }
      return { id: m.id, label: m.label, homeName: hn, awayName: an };
    });
    return { matches, results };
  }

  // R32
  const r32results = {};
  for (const m of r32pairings) {
    if (m.homeName === 'TBD' || m.awayName === 'TBD') continue;
    if (!advanced(m.homeName) || !advanced(m.awayName)) continue;
    const s = scoreFn(m.homeName, m.awayName);
    r32results[m.id] = { ...m, homeScore: s.h, awayScore: s.a };
  }

  const prevKo = { ...enriched, ...r32results };

  // R16
  const r16 = simRound(R16_MATCHUPS.map(m => ({ ...m, prev: m.prev, useLosers: false })), prevKo);
  Object.assign(prevKo, r16.results);

  // QF
  const qf = simRound(QF_MATCHUPS.map(m => ({ ...m, prev: m.prev, useLosers: false })), prevKo);
  Object.assign(prevKo, qf.results);

  // SF
  const sf = simRound(SF_MATCHUPS.map(m => ({ ...m, prev: m.prev, useLosers: false })), prevKo);
  Object.assign(prevKo, sf.results);

  // Finals
  const finals = simRound(FINAL_MATCHUPS, prevKo);
  const finalMatch = finals.results['FINAL'];
  const thirdMatch = finals.results['THIRD'];
  const champion = finalMatch ? (finalMatch.homeScore > finalMatch.awayScore ? finalMatch.homeName : finalMatch.awayName) : 'TBD';

  return { r32: r32pairings, r32results, r16: r16.matches, r16results: r16.results, qf: qf.matches, qfresults: qf.results, sf: sf.matches, sfresults: sf.results, finals: finals.matches, finalResults: finals.results, champion };
}

// --- Generate all model knockout predictions ---
const rankLookup = getTeamRankLookup('fifa', null);

// v1 & v2: pure rank-based
const v1ko = propagateBracket((hn, an) => v1koScore(getRank(hn), getRank(an)));
const v2ko = propagateBracket((hn, an) => v2koScore(getRank(hn), getRank(an)));

// v3: deterministic with jitter=0
const v3ko = propagateBracket((hn, an) => {
  const rh = rankLookup[hn] || 50;
  const ra = rankLookup[an] || 50;
  const s = deterministicPredictMatch(rh, ra, null);
  return { h: s.homeScore, a: s.awayScore };
});

// v4: heuristic (draw-rule + Poisson)
const v4ko = propagateBracket((hn, an) => {
  const rh = rankLookup[hn] || 50;
  const ra = rankLookup[an] || 50;
  const ptsH = GROUPS[Object.keys(GROUPS).find(l => GROUPS[l].teams.some(t => t.name === hn))]?.teams.find(t => t.name === hn)?.pts || 1500;
  const ptsA = GROUPS[Object.keys(GROUPS).find(l => GROUPS[l].teams.some(t => t.name === an))]?.teams.find(t => t.name === an)?.pts || 1500;
  const s = predictMatchScore4(rh, ra, ptsH, ptsA, true, hn);
  return { h: s.homeScore, a: s.awayScore };
});

// v5: from predictFullTournament (already have it)
const v5ko = full;

// baseline: from data file (only R32 keys)
const baselineKo = knockoutPredictions || {};

// --- Build R32 comparison table ---
const r32pairings = generateRoundOf32(enriched);
const koModelKeys = ['v1', 'v2', 'v3', 'v4', 'v5', 'baseline'];
const koModelNames = ['v1 Det', 'v2 Ext', 'v3 Prob', 'v4 Heur', 'v5 DC', 'Baseline'];

function getKoScore(modelKey, matchId) {
  if (modelKey === 'v1') return v1ko.r32results[matchId];
  if (modelKey === 'v2') return v2ko.r32results[matchId];
  if (modelKey === 'v3') return v3ko.r32results[matchId];
  if (modelKey === 'v4') return v4ko.r32results[matchId];
  if (modelKey === 'v5') return full.r32results[matchId];
  if (modelKey === 'baseline') return baselineKo[matchId];
  return null;
}

function koPredCell(modelKey, matchId, actual) {
  const r = getKoScore(modelKey, matchId);
  if (!r || r.homeScore == null) return { text: '\u2014', cls: 'pred-na' };
  const text = `${r.homeScore}-${r.awayScore}`;
  if (!actual) return { text, cls: 'pred-future' };
  const sameOutcome = Math.sign(r.homeScore - r.awayScore) === Math.sign(actual.homeScore - actual.awayScore);
  const sameExact = r.homeScore === actual.homeScore && r.awayScore === actual.awayScore;
  const sameGD = (r.homeScore - r.awayScore) === (actual.homeScore - actual.awayScore);
  let cls = 'pred-wrong';
  if (sameExact) cls = 'pred-exact';
  else if (sameOutcome && sameGD) cls = 'pred-gd';
  else if (sameOutcome) cls = 'pred-outcome';
  return { text, cls };
}

const r32CompRows = r32pairings.map(m => {
  const actual = RESULTS[m.id] || null;
  const cols = koModelKeys.map(k => koPredCell(k, m.id, actual));
  return { id: m.id, label: m.label, homeName: m.homeName, awayName: m.awayName, actual, cols };
});

// --- Build deeper round comparison per model ---
const koRoundDefs = [
  { key: 'r16', label: 'Round of 16', matchups: R16_MATCHUPS },
  { key: 'qf', label: 'Quarter-finals', matchups: QF_MATCHUPS },
  { key: 'sf', label: 'Semi-finals', matchups: SF_MATCHUPS },
];

function getModelMatches(modelKey, roundKey) {
  const data = { v1: v1ko, v2: v2ko, v3: v3ko, v4: v4ko, v5: v5ko, baseline: { r16results: {}, qfresults: {}, sfresults: {}, finalResults: {} } };
  const d = data[modelKey];
  if (!d) return {};
  if (roundKey === 'r16') return d.r16results || {};
  if (roundKey === 'qf') return d.qfresults || {};
  if (roundKey === 'sf') return d.sfresults || {};
  return {};
}

// Champion/third per model
const modelChampions = {};
for (const mk of ['v1', 'v2', 'v3', 'v4', 'v5']) {
  const data = { v1: v1ko, v2: v2ko, v3: v3ko, v4: v4ko, v5: v5ko };
  modelChampions[mk] = data[mk]?.champion || 'TBD';
}

function v1score(group, f) {
  const home = group.teams[f.homeIdx], away = group.teams[f.awayIdx];
  const gap = (home.rank - 3) - away.rank, absGap = Math.abs(gap);
  if (absGap >= 20) return gap < 0 ? { h: 3, a: 0 } : { h: 0, a: 3 };
  if (absGap >= 8) return gap < 0 ? { h: 2, a: 0 } : { h: 0, a: 2 };
  if (absGap >= 3) return gap < 0 ? { h: 2, a: 1 } : { h: 1, a: 2 };
  if (absGap >= 1) return gap < 0 ? { h: 1, a: 0 } : { h: 0, a: 1 };
  return { h: 1, a: 1 };
}
function v2score(group, f) {
  const home = group.teams[f.homeIdx], away = group.teams[f.awayIdx];
  const gap = (home.rank - 3) - away.rank, absGap = Math.abs(gap), hf = gap < 0;
  if (absGap >= 60) return hf ? { h: 5, a: 0 } : { h: 0, a: 5 };
  if (absGap >= 50) return hf ? { h: 4, a: 0 } : { h: 0, a: 4 };
  if (absGap >= 20) return hf ? { h: 3, a: 0 } : { h: 0, a: 3 };
  if (absGap >= 8) return hf ? { h: 2, a: 0 } : { h: 0, a: 2 };
  if (absGap >= 3) return hf ? { h: 2, a: 1 } : { h: 1, a: 2 };
  if (absGap >= 1) return hf ? { h: 1, a: 0 } : { h: 0, a: 1 };
  return { h: 1, a: 1 };
}

const v5preds = {};
for (const d of cmp.details) {
  const [hs, as] = d.predicted.split('-');
  v5preds[d.fixture] = { homeScore: +hs, awayScore: +as, lambdaHome: d.lambdaHome, lambdaAway: d.lambdaAway, actualPts: d.points };
}
for (const r of rem.predictions) {
  v5preds[r.fixture] = { homeScore: r.homeScore, awayScore: r.awayScore, confidence: r.confidence, expectedPoints: r.expectedPoints.toFixed(2) };
}

function predCell(m, actual) {
  if (m.h == null || m.a == null) return { text: '\u2014', cls: 'pred-na' };
  const text = `${m.h}-${m.a}`;
  if (!actual) return { text, cls: 'pred-future' };
  const sameOutcome = Math.sign(m.h - m.a) === Math.sign(actual.homeScore - actual.awayScore);
  const sameExact = m.h === actual.homeScore && m.a === actual.awayScore;
  const sameGD = (m.h - m.a) === (actual.homeScore - actual.awayScore);
  let cls = 'pred-wrong';
  if (sameExact) cls = 'pred-exact';
  else if (sameOutcome && sameGD) cls = 'pred-gd';
  else if (sameOutcome) cls = 'pred-outcome';
  return { text, cls };
}

const allGroups = GROUP_LETTERS.map(letter => {
  const group = GROUPS[letter];
  const fixtures = getGroupFixtures(letter);
  const rows = fixtures.map(f => {
    const actual = RESULTS[f.id];
    const sched = FIXTURE_SCHEDULE[f.id] || {};
    const homeName = group.teams[f.homeIdx].name;
    const awayName = group.teams[f.awayIdx].name;
    const v1 = v1score(group, f);
    const v2 = v2score(group, f);
    const v3p = v3pred.matchResults[f.id] || {};
    const v4p = v4pred.matchResults[f.id] || {};
    const v5p = v5preds[f.id] || {};
    const models = [
      { key: 'v1', h: v1.h, a: v1.a },
      { key: 'v2', h: v2.h, a: v2.a },
      { key: 'v3', h: v3p.homeScore, a: v3p.awayScore },
      { key: 'v4', h: v4p.homeScore, a: v4p.awayScore },
      { key: 'v5', h: v5p.homeScore, a: v5p.awayScore },
    ];
    const cols = models.map(m => predCell(m, actual));
    const v5extra = v5p;
    return { id: f.id, idx: f.id.slice(2), homeName, awayName, actual, sched, cols, v5extra };
  });
  const played = rows.filter(r => r.actual);
  const total = played.reduce((s, r) => s + (r.v5extra.actualPts || 0), 0);
  return { letter, name: group.name, teams: group.teams, rows, played: played.length, pts: total, maxPts: played.length * 10 };
});

const finalMatch = full.finalResults['FINAL'];
const thirdMatch = full.thirdResults['THIRD'];
const championName = finalMatch ? (finalMatch.homeScore > finalMatch.awayScore ? finalMatch.homeName : finalMatch.awayName) : 'TBD';
const thirdWinner = thirdMatch ? (thirdMatch.homeScore > thirdMatch.awayScore ? thirdMatch.homeName : thirdMatch.awayName) : 'TBD';
const models = [
  { key: 'v1', name: 'Deterministic (v1)', pct: cmp.v1.pct, total: cmp.v1.total, cls: '' },
  { key: 'v2', name: 'Extended (v2)', pct: cmp.v2.pct, total: cmp.v2.total, cls: '' },
  { key: 'v3', name: 'Probabilistic (v3)', pct: cmp.v3.pct, total: cmp.v3.total, cls: '' },
  { key: 'v4', name: 'Heuristic (v4)', pct: cmp.v4.pct, total: cmp.v4.total, cls: '' },
  { key: 'v5', name: 'Dixon-Coles (v5)', pct: cmp.v5.pct, total: cmp.v5.total, cls: 'highlight' },
];
const koRounds = [
  { label: 'Round of 32', matches: full.r32, results: full.r32results },
  { label: 'Round of 16', matches: full.r16, results: full.r16results },
  { label: 'Quarter-finals', matches: full.qf, results: full.qfresults },
  { label: 'Semi-finals', matches: full.sf, results: full.sfresults },
];
---

<Base>
  <header>
    <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
      <div>
        <h1>FIFA World Cup 2026</h1>
        <div class="subtitle">Model Comparison &amp; Predictions</div>
      </div>
      <a href="/" class="back-link" style="color:var(--accent2);font-size:0.85rem">\u2190 Back to Tracker</a>
    </div>
  </header>

  <main class="container">
    <div id="password-lock" class="password-lock">
      <div class="password-lock-inner">
        <div style="font-size:2rem;margin-bottom:8px">🔒</div>
        <h2 style="margin-bottom:4px">Password Required</h2>
        <p style="color:var(--textDim);font-size:0.85rem;margin-bottom:16px">Enter the password to view model comparisons.</p>
        <div style="display:flex;gap:8px;flex-direction:column;align-items:center">
          <input type="password" id="password-input" placeholder="Password" style="background:var(--bg);border:1px solid var(--border);border-radius:4px;color:var(--text);padding:8px 14px;font-size:0.9rem;width:200px;text-align:center" />
          <button class="btn btn-primary" id="unlock-btn">Unlock</button>
          <span id="password-error" style="color:var(--red);font-size:0.8rem;display:none">Incorrect password</span>
        </div>
      </div>
    </div>

    <div id="page-content" style="display:none">
      <section class="section">
        <h2 class="section-title">Model Performance <span class="badge">{cmp.played} played matches</span></h2>
        <p class="section-subtitle">SRF points earned. Max possible: <strong>{cmp.maxPts} pts</strong> ({cmp.played} \u00d7 10).</p>
        <div class="comparison-grid">
          {models.map(m => (
            <div class={"card model-card " + m.cls}>
              <div class="model-name">{m.name}</div>
              <div class="model-score">{m.total}</div>
              <div class="model-pct">{m.pct}%</div>
            </div>
          ))}
        </div>
      </section>

      {allGroups.map(g => (
        <section class="section">
          <h2 class="section-title" style="cursor:pointer" onclick="this.nextElementSibling.classList.toggle('collapsed')">
            {g.name} <span class="badge">{g.played}/6 played \u00b7 v5: {g.pts}/{g.maxPts}</span>
          </h2>
          <div class="group-table-wrap">
            <table class="data-table group-table">
              <thead>
                <tr>
                  <th></th><th>Home</th><th></th><th></th><th>Away</th>
                  <th class="col-v1">v1</th><th class="col-v2">v2</th><th class="col-v3">v3</th><th class="col-v4">v4</th><th class="col-v5">v5</th>
                </tr>
              </thead>
              <tbody>
                {g.rows.map(r => {
                  const dateStr = r.actual
                    ? <><strong>{r.actual.homeScore}-{r.actual.awayScore}</strong></>
                    : <span class="date-badge">{r.sched.date || '?'}</span>;
                  return (
                    <tr class={r.actual ? '' : 'row-future'}>
                      <td class="mono">{r.idx}</td>
                      <td class="tright">{r.homeName}</td>
                      <td class="score-cell">{dateStr}</td>
                      <td class="colon-cell">:</td>
                      <td>{r.awayName}</td>
                      {r.cols.map(c => <td class={"pred-cell " + c.cls}>{c.text}</td>)}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      ))}

      <section class="section">
        <h2 class="section-title">Upcoming Matches <span class="badge">{rem.predictions.length} remaining</span></h2>
        <p class="section-subtitle">v5 (Dixon-Coles) recommended tips. High = strong favorite, low = toss-up.</p>
        <div class="detail-table-wrap">
          <table class="data-table">
            <thead><tr><th>Match</th><th>Home</th><th></th><th></th><th>Away</th><th>Confidence</th><th>EV</th></tr></thead>
            <tbody>
              {rem.predictions.map(p => (
                <tr>
                  <td class="mono">{p.fixture}</td>
                  <td class="tright">{p.home}</td>
                  <td class="mono"><strong>{p.homeScore}</strong></td>
                  <td class="mono"><strong>{p.awayScore}</strong></td>
                  <td>{p.away}</td>
                  <td><span class={"conf-badge conf-" + p.confidence}>{p.confidence}</span></td>
                  <td class="mono">{p.expectedPoints.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Knockout Model Comparison -->
      <section class="section">
        <h2 class="section-title">Knockout Model Comparison <span class="badge">6 models</span></h2>
        <p class="section-subtitle">
          All models use actual group standings for R32 pairings. Color coding: 
          <span class="badge-exact">exact</span>
          <span class="badge-gd">GD</span>
          <span class="badge-outcome">outcome</span>
          <span class="badge-wrong">wrong</span>
          for completed matches; dim = prediction for future matches.
        </p>

        <h3 style="font-size:1rem;margin:16px 0 8px">Round of 32</h3>
        <div class="ko-comp-wrap">
          <table class="data-table ko-comp-table">
            <thead>
              <tr>
                <th></th><th>Home</th><th></th><th></th><th>Away</th>
                <th class="col-v1">v1</th><th class="col-v2">v2</th><th class="col-v3">v3</th><th class="col-v4">v4</th><th class="col-v5">v5</th><th class="col-baseline">BL</th>
              </tr>
            </thead>
            <tbody>
              {r32CompRows.map(r => {
                const actualStr = r.actual
                  ? <><strong>{r.actual.homeScore}-{r.actual.awayScore}</strong></>
                  : <span class="date-badge">upcoming</span>;
                return (
                  <tr class={r.actual ? '' : 'row-future'}>
                    <td class="mono">{r.label || r.id}</td>
                    <td class="tright">{r.homeName}</td>
                    <td class="score-cell">{actualStr}</td>
                    <td class="colon-cell">:</td>
                    <td>{r.awayName}</td>
                    {r.cols.map(c => <td class={"pred-cell " + c.cls}>{c.text}</td>)}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {koRoundDefs.map(rd => {
          // Collect per-model results for this round
          const modelRoundMatches = {};
          for (const mk of koModelKeys) {
            const mresults = getModelMatches(mk, rd.key);
            modelRoundMatches[mk] = mresults;
          }
          // Get all unique match IDs from any model
          const allIds = new Set();
          for (const mk of koModelKeys) {
            for (const id of Object.keys(modelRoundMatches[mk])) allIds.add(id);
          }
          const matchList = rd.matchups.filter(m => allIds.has(m.id));
          return (
            <div style="margin-top:20px">
              <h3 style="font-size:1rem;margin-bottom:8px">{rd.label}</h3>
              <div class="ko-comp-wrap">
                <table class="data-table ko-comp-table">
                  <thead>
                    <tr>
                      <th>Match</th>
                      <th class="col-v1">v1</th>
                      <th class="col-v2">v2</th>
                      <th class="col-v3">v3</th>
                      <th class="col-v4">v4</th>
                      <th class="col-v5">v5</th>
                      <th class="col-baseline">BL</th>
                    </tr>
                  </thead>
                  <tbody>
                    {matchList.map(m => {
                      const cells = koModelKeys.map(mk => {
                        const r = modelRoundMatches[mk][m.id];
                        if (!r || r.homeScore == null) return { text: '\u2014', cls: 'pred-na' };
                        const winner = r.homeScore > r.awayScore ? r.homeName : (r.awayScore > r.homeScore ? r.awayName : 'Draw');
                        return { text: `${r.homeName} ${r.homeScore}-${r.awayScore} ${r.awayName}`, cls: 'pred-future', winner };
                      });
                      return (
                        <tr>
                          <td class="mono">{m.label || m.id}</td>
                          {cells.map(c => <td class={"pred-cell ko-cell " + c.cls}>{c.text}</td>)}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })}

        <div style="margin-top:20px">
          <h3 style="font-size:1rem;margin-bottom:8px">Finals &amp; Champion</h3>
          <div class="ko-comp-wrap">
            <table class="data-table ko-comp-table">
              <thead>
                <tr>
                  <th>Match</th>
                  <th class="col-v1">v1</th>
                  <th class="col-v2">v2</th>
                  <th class="col-v3">v3</th>
                  <th class="col-v4">v4</th>
                  <th class="col-v5">v5</th>
                  <th class="col-baseline">BL</th>
                </tr>
              </thead>
              <tbody>
                {(() => {
                  const finalsData = { v1: v1ko.finalResults, v2: v2ko.finalResults, v3: v3ko.finalResults, v4: v4ko.finalResults, v5: v5ko.finalResults, baseline: {} };
                  const rows = [];
                  for (const matchId of ['THIRD', 'FINAL']) {
                    const label = matchId === 'THIRD' ? 'Third Place' : 'Final';
                    const cells = koModelKeys.map(mk => {
                      const fr = finalsData[mk];
                      const r = fr?.[matchId];
                      if (!r || r.homeScore == null) return { text: '\u2014', cls: 'pred-na' };
                      return { text: `${r.homeName} ${r.homeScore}-${r.awayScore} ${r.awayName}`, cls: 'pred-future' };
                    });
                    rows.push(<tr><td class="mono">{label}</td>{cells.map(c => <td class={"pred-cell ko-cell " + c.cls}>{c.text}</td>)}</tr>);
                  }
                  // Champion row
                  const champCells = koModelKeys.map(mk => {
                    const ch = modelChampions[mk];
                    return { text: ch || '\u2014', cls: ch && ch !== 'TBD' ? 'pred-future' : 'pred-na' };
                  });
                  rows.push(<tr style="border-top:2px solid var(--border)"><td class="mono"><strong>Champion</strong></td>{champCells.map(c => <td class={"pred-cell ko-cell " + c.cls}><strong>{c.text}</strong></td>)}</tr>);
                  return rows;
                })()}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Knockout Prediction <span class="badge">v5 Dixon-Coles</span></h2>
        <div class="prediction-cards">
          <div class="card prediction-card"><div class="pred-label">World Champion</div><div class="pred-value gold">{championName}</div></div>
          <div class="card prediction-card"><div class="pred-label">Switzerland Reaches</div><div class="pred-value">{full.switzerlandRound}</div></div>
          <div class="card prediction-card"><div class="pred-label">Switzerland Goals</div><div class="pred-value">{full.switzerlandGoals}</div></div>
          <div class="card prediction-card"><div class="pred-label">3rd Place</div><div class="pred-value">{thirdWinner}</div></div>
        </div>

        {koRounds.map(r => (
          <div style="margin-top:16px">
            <h3 style="font-size:1rem;margin-bottom:6px">{r.label}</h3>
            <table class="data-table ko-table">
              <tbody>
                {r.matches.map(m => {
                  const res = r.results[m.id];
                  if (!res) return <tr><td class="mono">{m.label || m.id}</td><td><span class="dim">\u2014</span></td></tr>;
                  const winner = res.homeScore > res.awayScore ? res.homeName : res.awayName;
                  return (
                    <tr>
                      <td class="mono">{m.label || m.id}</td>
                      <td><span class={winner === res.homeName ? 'win' : 'loss'}>{res.homeName}</span> <strong>{res.homeScore}-{res.awayScore}</strong> <span class={winner === res.awayName ? 'win' : 'loss'}>{res.awayName}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ))}

        <div style="margin-top:16px">
          <h3 style="font-size:1rem;margin-bottom:6px">Finals</h3>
          <table class="data-table ko-table">
            <tbody>
              {thirdMatch && (
                <tr>
                  <td>Third Place</td>
                  <td><span class={thirdMatch.homeScore > thirdMatch.awayScore ? 'win' : 'loss'}>{thirdMatch.homeName}</span> <strong>{thirdMatch.homeScore}-{thirdMatch.awayScore}</strong> <span class={thirdMatch.awayScore > thirdMatch.homeScore ? 'win' : 'loss'}>{thirdMatch.awayName}</span></td>
                </tr>
              )}
              {finalMatch && (
                <tr>
                  <td>Final</td>
                  <td><span class={finalMatch.homeScore > finalMatch.awayScore ? 'win' : 'loss'}>{finalMatch.homeName}</span> <strong>{finalMatch.homeScore}-{finalMatch.awayScore}</strong> <span class={finalMatch.awayScore > finalMatch.homeScore ? 'win' : 'loss'}>{finalMatch.awayName}</span></td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Methodology</h2>
        <div style="font-size:0.88rem;color:var(--textDim);line-height:1.7">
          <p><strong>v1 Deterministic:</strong> Rank-gap thresholds (host rank -3 in group stage, pure rank in KO). Gap \u2265 20 \u2192 3-0, \u2265 8 \u2192 2-0, \u2265 3 \u2192 2-1, \u2265 1 \u2192 1-0, else 1-1.</p>
          <p><strong>v2 Extended:</strong> Same logic, extended thresholds up to 5-0 for gap \u2265 60.</p>
          <p><strong>v3 Probabilistic:</strong> Seeded RNG simulation; match outcomes drawn from rank-weighted probabilities. Deterministic variant used for KO.</p>
          <p><strong>v4 Heuristic:</strong> Poisson-based with FIFA pts as strength. Draw rule: |gap| \u2264 5 \u2192 1-1 in group stage.</p>
          <p><strong>v5 Dixon-Coles:</strong> Attack/defense per team. FIFA prior + tournament evidence (weight = min(0.85, played \u00d7 0.2)). SRF-optimized score selection. Host advantage 1.2\u00d7 for Mexico/USA/Canada in group stage.</p>
          <p><strong>Baseline:</strong> Hand-crafted predictions with reasoning for each match.</p>
        </div>
      </section>
    </div>
  </main>
</Base>

