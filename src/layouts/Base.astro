---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>World Cup 2026 — Championship Bracket</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏆</text></svg>" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</head>
<body>
  <nav class="top-nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">🏆 WC2026</a>
      <div class="nav-links">
        <a href="/" class="nav-link">Tracker</a>
        <a href="/rankings" class="nav-link">Rankings</a>
        <a href="/teams" class="nav-link">Squads</a>
        <a href="/trivia" class="nav-link">Trivia</a>
        <a href="/baseline" class="nav-link">Baseline</a>
        <a href="/assistant" class="nav-link">Assistent</a>
      </div>
    </div>
  </nav>
  <slot />
  <footer style="text-align:center;padding:24px;color:var(--textDim);font-size:0.8rem">
    FIFA World Cup 2026 — Championship Tracker
  </footer>
  <div class="apparition dino" style="top:56px;left:0">🦖</div>
  <div class="apparition leaf" style="top:56px;right:0">🍁</div>
  <div class="apparition llama" style="top:50%;right:0">🦙</div>
  <div class="apparition burger" style="bottom:24px;left:24px">🍔</div>
  <div class="apparition party" style="bottom:24px;right:24px">🎉</div>
  <div class="apparition messi" style="top:18%;left:0"><img src="/images/cartoons/messi.png" width="52" height="86" alt="Messi"></div>
  <div class="apparition ronalda" style="top:32%;right:0"><img src="/images/cartoons/ronaldo.png" width="52" height="75" alt="Ronaldo"></div>
  <div class="apparition kane" style="top:68%;left:0"><img src="/images/cartoons/kane.png" width="52" height="85" alt="Kane"></div>
  <div class="apparition haaland" style="top:44%;right:0"><img src="/images/cartoons/haaland.png" width="52" height="78" alt="Haaland"></div>
  <div class="apparition mbappe" style="bottom:64px;left:50%"><img src="/images/cartoons/mbappe.png" width="52" height="82" alt="Mbappé"></div>
  <div class="click-hint">👆 click an emoji</div>
<script>
document.querySelectorAll('.apparition').forEach(el => {
  el.addEventListener('click', function(e) {
    const rect = this.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const cls = this.classList[1];

    if (cls === 'dino') {
      const a = this.animate([
        { transform: 'scale(1) rotate(0deg)', opacity: 1 },
        { transform: 'scale(1.3) rotate(360deg)', opacity: 0.8 },
        { transform: 'scale(0.8) rotate(720deg)', opacity: 0.4 },
        { transform: 'translate(-80px, -180px) scale(0.3) rotate(1080deg)', opacity: 0 },
      ], { duration: 700, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    } else if (cls === 'llama') {
      const a = this.animate([
        { transform: 'scale(1) rotate(0deg)', opacity: 1 },
        { transform: 'scale(1.3) rotate(-360deg)', opacity: 0.8 },
        { transform: 'scale(0.8) rotate(-720deg)', opacity: 0.4 },
        { transform: 'translate(80px, -180px) scale(0.3) rotate(-1080deg)', opacity: 0 },
      ], { duration: 700, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    } else if (cls === 'messi') {
      const a = this.animate([
        { transform: 'scale(1) translate(0,0)', opacity: 1 },
        { transform: 'scale(1.4) translate(20px,-30px)', opacity: 0.8 },
        { transform: 'scale(0.6) translate(-30px,-80px)', opacity: 0.4 },
        { transform: 'scale(0.2) translate(40px,-150px)', opacity: 0 },
      ], { duration: 800, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    } else if (cls === 'ronalda') {
      const a = this.animate([
        { transform: 'scale(1) rotate(0deg)', opacity: 1 },
        { transform: 'scale(1.5) rotate(-180deg)', opacity: 0.7 },
        { transform: 'scale(0.8) rotate(-360deg)', opacity: 0.3, offset: 0.6 },
        { transform: 'scale(0) rotate(-540deg) translateY(-120px)', opacity: 0 },
      ], { duration: 750, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    } else if (cls === 'kane') {
      const a = this.animate([
        { transform: 'scale(1) rotate(0deg) translate(0,0)', opacity: 1 },
        { transform: 'scale(1.6) rotate(15deg) translate(40px,-20px)', opacity: 0.7 },
        { transform: 'scale(0.5) rotate(-10deg) translate(-20px,-60px)', opacity: 0.3 },
        { transform: 'scale(0.1) rotate(30deg) translate(80px,-120px)', opacity: 0 },
      ], { duration: 650, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    } else if (cls === 'haaland') {
      const a = this.animate([
        { transform: 'scale(1) skewX(0deg)', opacity: 1 },
        { transform: 'scale(1.5) skewX(-15deg)', opacity: 0.8 },
        { transform: 'scale(0.7) skewX(10deg)', opacity: 0.4 },
        { transform: 'scale(0) skewX(-20deg) translateY(-100px)', opacity: 0 },
      ], { duration: 600, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    } else if (cls === 'mbappe') {
      const a = this.animate([
        { transform: 'scale(1)', opacity: 1 },
        { transform: 'scale(1.7) translate(-10px,-20px)', opacity: 0.7 },
        { transform: 'scale(0.4) translate(30px,-50px)', opacity: 0.3 },
        { transform: 'scale(0) translate(-40px,-120px)', opacity: 0 },
      ], { duration: 700, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    } else {
      const a = this.animate([
        { transform: 'scale(1)', opacity: 1 },
        { transform: 'scale(2.5)', opacity: 0.6 },
        { transform: 'scale(0)', opacity: 0 },
      ], { duration: 500, easing: 'ease-out', fill: 'forwards' });
      a.onfinish = () => reset(this);
    }

    function reset(el) {
      el.style.transform = '';
      el.style.opacity = '';
    }

    const configs = {
      dino: { count: 35, colors: ['#ff4500','#ff8c00','#ffd700','#ff6347'], life: 900, spread: 200 },
      leaf: { count: 30, colors: ['#7cfc00','#adff2f','#ffd700','#98fb98'], life: 1200, spread: 150, gravity: true },
      llama: { count: 50, colors: ['#ff0','#f0f','#0ff','#f00','#0f0','#00f'], life: 900, spread: 180, confetti: true },
      burger: { count: 25, colors: ['#ffd700','#fff8dc','#ffd700'], life: 700, spread: 130, star: true },
      party: { count: 60, colors: ['#ff0','#f0f','#0ff','#f00','#0f0','#00f','#ff8c00','#fff'], life: 1000, spread: 250, confetti: true },
      messi: { count: 40, colors: ['#75aadb','#fff','#ffd700','#000080'], life: 1000, spread: 200, confetti: true },
      ronalda: { count: 45, colors: ['#ff0','#da291c','#006600','#ffd700'], life: 950, spread: 190, confetti: true },
      kane: { count: 30, colors: ['#ffd700','#fff','#c8102e','#1d2b64'], life: 850, spread: 170, star: true },
      haaland: { count: 55, colors: ['#f0f','#0ff','#ff0','#fff'], life: 800, spread: 220, confetti: true },
      mbappe: { count: 35, colors: ['#002395','#fff','#ed2939','#00d2ff'], life: 900, spread: 180, star: true },
    };

    const cfg = configs[cls] || configs.party;

    for (let i = 0; i < cfg.count; i++) {
      const p = document.createElement('div');
      p.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;z-index:999;pointer-events:none;`;

      const size = 6 + Math.random() * 8;
      const angle = Math.random() * 360;
      const dist = (40 + Math.random() * cfg.spread) * (cfg.star ? 0.6 : 1);
      const dx = Math.cos(angle * Math.PI / 180) * dist;
      const dy = Math.sin(angle * Math.PI / 180) * dist - (cfg.gravity ? 60 : 0);
      const color = cfg.colors[Math.floor(Math.random() * cfg.colors.length)];

      if (cfg.confetti) {
        p.textContent = ['●','▪','♦','★','♥'][Math.floor(Math.random()*5)];
        p.style.cssText += `font-size:${size}px;color:${color};`;
      } else if (cfg.star) {
        p.textContent = '⭐';
        p.style.cssText += `font-size:${size * 0.6}px;`;
      } else {
        p.style.cssText += `width:${size}px;height:${size}px;border-radius:50%;background:${color};`;
      }

      document.body.appendChild(p);

      const rx = dx + (Math.random() - 0.5) * 40;
      const ry = dy + (Math.random() - 0.5) * 40;

      p.animate([
        { transform: 'translate(0,0) scale(1)', opacity: 1 },
        { transform: `translate(${rx}px,${ry}px) scale(0.3)`, opacity: 0 },
      ], { duration: cfg.life, easing: 'ease-out', fill: 'forwards' }).onfinish = () => p.remove();
    }
  });
});
</script>
</body>
</html>

<style is:global>
  .top-nav {
    background: linear-gradient(135deg, #0f1a2e, #1a2a4a);
    border-bottom: 1px solid var(--border);
    padding: 10px 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
  }
  .nav-links {
    display: flex;
    gap: 4px;
  }
  .nav-link {
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--textDim);
    text-decoration: none;
    transition: all 0.15s;
  }
  .nav-link:hover {
    color: var(--text);
    background: rgba(255,255,255,0.05);
  }
  .h1-trivia {
    display: inline-block;
    font-size: inherit;
    font-weight: 700;
    text-decoration: none;
    color: #000;
    background: linear-gradient(135deg, var(--gold), #d97706);
    padding: 2px 12px;
    border-radius: 20px;
    vertical-align: middle;
    letter-spacing: 0.5px;
    animation: trivia-pulse 2.5s ease-in-out infinite;
    line-height: 1.4;
  }
  .h1-trivia:hover {
    background: linear-gradient(135deg, #d97706, #b45309);
    transform: scale(1.05);
  }
  @keyframes trivia-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245,158,11,0.3); }
    50% { box-shadow: 0 0 0 6px rgba(245,158,11,0); }
  }
  .bouncing-ball {
    display: inline-block;
    font-size: 0.7em;
    animation: ball-bounce 2.5s ease-in-out infinite;
  }
  @keyframes ball-bounce {
    0%, 100% { transform: translateY(0); }
    25% { transform: translateY(-3px); }
    50% { transform: translateY(0); }
    75% { transform: translateY(-2px); }
  }

  .apparition {
    position: fixed;
    z-index: 90;
    font-size: 2.6rem;
    cursor: pointer;
    user-select: none;
    opacity: 0;
    line-height: 1;
    transition: transform 0.1s;
  }
  .apparition:hover { transform: scale(1.25); }

  .click-hint {
    position: fixed;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99;
    font-size: 0.75rem;
    color: var(--textDim);
    opacity: 0.3;
    pointer-events: none;
    user-select: none;
    letter-spacing: 0.3px;
  }

  .dino { animation: pop-dino 53s ease-in-out infinite; }
  .leaf { animation: pop-leaf 43s ease-in-out infinite; }
  .llama { animation: pop-llama 47s ease-in-out infinite; }
  .burger { animation: pop-burger 61s ease-in-out infinite; }
  .party { animation: pop-party 59s ease-in-out infinite; }

  @keyframes pop-dino {
    0%, 75%, 100% { opacity: 0; transform: translateX(-60px) scale(0.3); }
    78% { opacity: 1; transform: translateX(20px) scale(1); }
    82% { opacity: 1; transform: translateX(40px) scale(1.2) rotate(-6deg); }
    86% { opacity: 1; transform: translateX(35px) scale(1) rotate(4deg); }
    90% { opacity: 1; transform: translateX(40px) scale(1.1) rotate(-3deg); }
    94% { opacity: 0; transform: translateX(-60px) scale(0.3); }
  }

  @keyframes pop-leaf {
    0%, 72%, 100% { opacity: 0; transform: translate(60px, -40px) scale(0.3) rotate(0deg); }
    75% { opacity: 1; transform: translate(-20px, 10px) scale(1) rotate(15deg); }
    80% { opacity: 1; transform: translate(-40px, 20px) scale(1.1) rotate(-10deg); }
    85% { opacity: 1; transform: translate(-35px, 30px) scale(1) rotate(8deg); }
    90% { opacity: 1; transform: translate(-40px, 15px) scale(1.05) rotate(-5deg); }
    94% { opacity: 0; transform: translate(60px, -40px) scale(0.3) rotate(0deg); }
  }

  @keyframes pop-llama {
    0%, 72%, 100% { opacity: 0; transform: translate(80px, -50%) scale(0.3); }
    75% { opacity: 1; transform: translate(-40px, -50%) scale(1); }
    79% { opacity: 1; transform: translate(-30px, -120%) scale(1.1) rotate(360deg); }
    83% { opacity: 1; transform: translate(-40px, -50%) scale(1); }
    88% { opacity: 1; transform: translate(-35px, -60%) scale(1.05); }
    94% { opacity: 0; transform: translate(80px, -50%) scale(0.3); }
  }

  @keyframes pop-burger {
    0%, 75%, 100% { opacity: 0; transform: translateY(40px) scale(0.3) rotate(-30deg); }
    78% { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); }
    82% { opacity: 1; transform: translateY(-10px) scale(1.1) rotate(12deg); }
    86% { opacity: 1; transform: translateY(0) scale(1) rotate(-6deg); }
    90% { opacity: 1; transform: translateY(-6px) scale(1.05) rotate(6deg); }
    94% { opacity: 0; transform: translateY(40px) scale(0.3) rotate(-30deg); }
  }

  @keyframes pop-party {
    0%, 72%, 100% { opacity: 0; transform: scale(0) rotate(0deg); }
    75% { opacity: 1; transform: scale(1) rotate(0deg); }
    79% { opacity: 1; transform: scale(1.3) rotate(-15deg); }
    84% { opacity: 1; transform: scale(1.1) rotate(8deg); }
    89% { opacity: 1; transform: scale(1.2) rotate(-5deg); }
    94% { opacity: 0; transform: scale(0) rotate(0deg); }
  }

  .messi { animation: pop-messi 37s ease-in-out infinite; }
  .ronalda { animation: pop-ronalda 41s ease-in-out infinite; }
  .kane { animation: pop-kane 49s ease-in-out infinite; }
  .haaland { animation: pop-haaland 31s ease-in-out infinite; }
  .mbappe { animation: pop-mbappe 43s ease-in-out infinite; }

  @keyframes pop-messi {
    0%, 73%, 100% { opacity: 0; transform: translateX(-80px) scale(0.3); }
    76% { opacity: 1; transform: translateX(10px) scale(0.9) rotate(-4deg); }
    79% { opacity: 1; transform: translateX(30px) scale(1) rotate(3deg); }
    82% { opacity: 1; transform: translateX(15px) scale(1.1) rotate(-6deg); }
    85% { opacity: 1; transform: translateX(25px) scale(1) rotate(4deg); }
    88% { opacity: 1; transform: translateX(18px) scale(1.05) rotate(-2deg); }
    91% { opacity: 0; transform: translateX(-80px) scale(0.3); }
  }

  @keyframes pop-ronalda {
    0%, 70%, 100% { opacity: 0; transform: translateX(80px) scale(0.3) rotate(30deg); }
    73% { opacity: 1; transform: translateX(-15px) scale(1) rotate(0deg); }
    76% { opacity: 1; transform: translateX(-5px) scale(1.2) rotate(-10deg); }
    79% { opacity: 1; transform: translateX(-15px) scale(1) rotate(5deg); }
    82% { opacity: 1; transform: translateX(-8px) scale(1.15) rotate(-8deg); }
    85% { opacity: 1; transform: translateX(-12px) scale(1.05) rotate(3deg); }
    90% { opacity: 0; transform: translateX(80px) scale(0.3) rotate(30deg); }
  }

  @keyframes pop-kane {
    0%, 74%, 100% { opacity: 0; transform: translate(-60px, 40px) scale(0.2) rotate(-45deg); }
    77% { opacity: 1; transform: translate(0, 0) scale(1) rotate(0deg); }
    80% { opacity: 1; transform: translate(10px, -15px) scale(1.15) rotate(10deg); }
    83% { opacity: 1; transform: translate(5px, -5px) scale(1) rotate(-5deg); }
    86% { opacity: 1; transform: translate(8px, -10px) scale(1.08) rotate(5deg); }
    92% { opacity: 0; transform: translate(-60px, 40px) scale(0.2) rotate(-45deg); }
  }

  @keyframes pop-haaland {
    0%, 68%, 100% { opacity: 0; transform: translateX(70px) scale(0.3); }
    71% { opacity: 1; transform: translateX(-10px) scale(1) skewX(0deg); }
    73% { opacity: 1; transform: translateX(5px) scale(1.15) skewX(-8deg); }
    75% { opacity: 1; transform: translateX(-5px) scale(1) skewX(5deg); }
    78% { opacity: 1; transform: translateX(3px) scale(1.1) skewX(-3deg); }
    82% { opacity: 1; transform: translateX(-2px) scale(1.05) skewX(2deg); }
    88% { opacity: 0; transform: translateX(70px) scale(0.3); }
  }

  @keyframes pop-mbappe {
    0%, 66%, 100% { opacity: 0; transform: translate(-50%, 20px) scale(0.3); }
    69% { opacity: 1; transform: translate(-50%, -5px) scale(1); }
    72% { opacity: 1; transform: translate(-50%, 8px) scale(1.15) rotate(-3deg); }
    75% { opacity: 1; transform: translate(-50%, -3px) scale(1) rotate(2deg); }
    79% { opacity: 1; transform: translate(-50%, 4px) scale(1.1) rotate(-1deg); }
    85% { opacity: 0; transform: translate(-50%, 20px) scale(0.3); }
  }
</style>
